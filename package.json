{
  "name": "sinon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rules/no-sensitive-content": "./plugins/harness/tooling/pnpm/runtime/no-sensitive-content.js"
  },
  "scripts": {
    "check": "run-p pre-push verify:*",
    "check:formal-layout": "pnpm --filter @sinon/formal-verification run check:layout",
    "check:markdownlint-cli2": "markdownlint-cli2 \"**/*.md\"",
    "check:promtool": "pnpm --filter @sinon/formal-verification run check:model",
    "check:promtool:child": "pnpm --filter @sinon/formal-verification run check:model ChildLifecycle",
    "check:promtool:download": "pnpm --filter @sinon/formal-verification run check:model DownloadLifecycle",
    "check:sensitive-content": "node .github/scripts/sync-sensitive-content.ts",
    "check:statecharts": "pnpm --filter @sinon/formal-verification run check:statecharts",
    "check:test": "run-p check:test:*",
    "check:typescript": "run-p check:typescript:*",
    "check:typescript:formal-verification": "pnpm --filter @sinon/formal-verification run check:typescript",
    "check:typescript:github": "tsc --project .github/tsconfig.json",
    "check:typescript:root": "tsc",
    "check:ultracite": "ultracite check",
    "check:versions": "node .github/scripts/sync-versions.ts",
    "check:yaml-sequences": "node rules/yaml-sequence-style.ts",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 \"**/*.md\" --fix",
    "fix:ultracite": "ultracite fix --type-aware",
    "pre-commit": "node --import tsx .github/scripts/pre-commit-scope.ts",
    "prepack": "node .github/scripts/sync-sensitive-content.ts",
    "pre-push": "run-p check:*",
    "prepare": "husky",
    "rules:sync": "node .github/scripts/sync-sensitive-content.ts --write",
    "statecharts:render": "pnpm --filter @sinon/formal-verification run render:statechart",
    "versions:sync": "node .github/scripts/sync-versions.ts --write",
    "check:test:unit": "vitest run",
    "verify:promtool-fixtures": "pnpm --dir plugins/observability-assets run promtool",
    "verify:consumers": "node .github/scripts/check-consumers.ts"
  },
  "devDependencies": {
    "@google/design.md": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^24.22.3"
  },
  "packageManager": "pnpm@12.21.0"
}
