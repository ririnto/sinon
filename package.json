{
  "name": "sinon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rules/no-sensitive-content": "./plugins/harness/tooling/pnpm/rules/no-sensitive-content.mjs"
  },
  "scripts": {
    "check": "run-p check:*",
    "check:markdownlint-cli2": "markdownlint-cli2 \"**/*.md\"",
    "check:promtool": "run-p check:promtool:*",
    "check:promtool:child": "model_dir=$(mktemp -d) && trap 'rm -rf \"$model_dir\"' EXIT && java -XX:+UseParallelGC -cp node_modules/tla-chaos-loop/tools/tla2tools.jar tlc2.TLC -workers 1 -metadir \"$model_dir\" -config plugins/observability-assets/tests/promtool/model/ChildLifecycle.cfg plugins/observability-assets/tests/promtool/model/ChildLifecycle.tla",
    "check:promtool:download": "model_dir=$(mktemp -d) && trap 'rm -rf \"$model_dir\"' EXIT && java -XX:+UseParallelGC -cp node_modules/tla-chaos-loop/tools/tla2tools.jar tlc2.TLC -workers 1 -metadir \"$model_dir\" -config plugins/observability-assets/tests/promtool/model/DownloadLifecycle.cfg plugins/observability-assets/tests/promtool/model/DownloadLifecycle.tla",
    "check:test": "run-p check:test:*",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "run-s ultracite:check ultracite:check:harness",
    "check:versions": "node .github/scripts/sync-versions.mjs",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 \"**/*.md\" --fix",
    "fix:ultracite": "run-s ultracite:fix ultracite:fix:harness",
    "pre-commit": "node --import tsx .github/scripts/pre-commit-scope.ts",
    "pre-push": "run-s check",
    "prepare": "husky",
    "ultracite:check": "ultracite check --config oxlint.config.ts --ignore-pattern \"plugins/harness/tooling/pnpm/**\"",
    "ultracite:check:harness": "ultracite check --type-aware --config oxlint.config.ts plugins/harness/tooling/pnpm",
    "ultracite:fix": "ultracite fix --config oxlint.config.ts --ignore-pattern \"plugins/harness/tooling/pnpm/**\"",
    "ultracite:fix:harness": "ultracite fix --type-aware --config oxlint.config.ts plugins/harness/tooling/pnpm",
    "versions:sync": "node .github/scripts/sync-versions.mjs --write",
    "check:test:unit": "vitest run",
    "check:test:promtool": "tsx plugins/observability-assets/tests/promtool/run.ts"
  },
  "devDependencies": {
    "@google/design.md": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tar": "catalog:",
    "tla-chaos-loop": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "config": {
    "promtoolVersion": "3.13.5"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
