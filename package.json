{
  "name": "sinon",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:codegraph": "vitest run plugins/codegraph/tests",
    "check:java": "vitest run plugins/java/tests",
    "check:lint-rules": "vitest run rules plugins/harness/tooling/pnpm plugins/harness/tests --maxWorkers=1",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:marketplace": "run-s marketplace:check marketplace:test",
    "check:promtool-release": "vitest run plugins/observability-assets/tests/promtool/release.test.ts",
    "check:react-effects": "ultracite check --config oxlint.react-effects.config.ts",
    "check:sdd": "vitest run plugins/spec-driven-development/tests",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "run-s ultracite:check ultracite:check:marketplace",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix",
    "marketplace:check": "node --import tsx .claude-plugin/marketplace/generate.ts --check",
    "marketplace:generate": "node --import tsx .claude-plugin/marketplace/generate.ts",
    "marketplace:test": "vitest run .claude-plugin/marketplace/generate.test.ts",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky",
    "test:promtool": "tsx plugins/observability-assets/tests/promtool/run.ts",
    "ultracite:check": "ultracite check",
    "ultracite:check:marketplace": "ultracite check .claude-plugin/marketplace"
  },
  "devDependencies": {
    "@google/design.md": "catalog:",
    "@oxc-project/types": "catalog:",
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pnpm": "catalog:",
    "tar": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "config": {
    "promtoolVersion": "3.15.0"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.15.0"
}
