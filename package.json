{
  "name": "sinon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rules/no-sensitive-content": "./plugins/harness/tooling/pnpm/rules/no-sensitive-content.mjs"
  },
  "scripts": {
    "check": "run-p pre-push verify:*",
    "check:markdownlint-cli2": "markdownlint-cli2 \"**/*.md\"",
    "check:promtool": "run-p check:promtool:*",
    "check:promtool:child": "pnpm --dir plugins/observability-assets run model ChildLifecycle",
    "check:promtool:download": "pnpm --dir plugins/observability-assets run model DownloadLifecycle",
    "check:statecharts": "node .claude/skills/formal-verification/scripts/render-statecharts.ts --check",
    "check:test": "run-p check:test:*",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "ultracite check",
    "check:versions": "node .github/scripts/sync-versions.mjs",
    "check:yaml-sequences": "node rules/yaml-sequence-style.ts",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 \"**/*.md\" --fix",
    "fix:ultracite": "ultracite fix --type-aware",
    "pre-commit": "node --import tsx .github/scripts/pre-commit-scope.ts",
    "pre-push": "run-p check:*",
    "prepare": "husky",
    "statecharts:render": "node .claude/skills/formal-verification/scripts/render-statecharts.ts",
    "versions:sync": "node .github/scripts/sync-versions.mjs --write",
    "check:test:unit": "vitest run",
    "verify:promtool-fixtures": "pnpm --dir plugins/observability-assets run promtool",
    "verify:consumers": "node .github/scripts/check-consumers.ts"
  },
  "devDependencies": {
    "@google/design.md": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pele": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^24.22.3"
  },
  "packageManager": "pnpm@12.21.0"
}
