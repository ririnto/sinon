{
  "name": "sinon",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:codegraph": "vitest run plugins/codegraph/tests",
    "check:lint-rules": "vitest run plugins/harness/tooling/pnpm",
    "check:marketplace": "node --import tsx .claude-plugin/marketplace/generate.ts --check && vitest run .claude-plugin/marketplace/generate.test.ts",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:promtool-release": "vitest run plugins/observability-assets/tests/promtool/release.test.ts",
    "check:sdd": "vitest run plugins/spec-driven-development/tests",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "ultracite check && ultracite check .claude-plugin/marketplace",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix",
    "marketplace:generate": "node --import tsx .claude-plugin/marketplace/generate.ts",
    "test:promtool": "tsx plugins/observability-assets/tests/promtool/run.ts"
  },
  "devDependencies": {
    "@oxc-project/types": "catalog:",
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tar": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "config": {
    "promtoolVersion": "3.15.0"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.10.1"
}
