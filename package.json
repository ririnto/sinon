{
  "name": "sinon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rules/no-sensitive-content": "./plugins/harness/tooling/pnpm/rules/no-sensitive-content.mjs"
  },
  "scripts": {
    "check": "run-p check:*",
    "check:hook-scope": "vitest run .github/scripts/pre-commit-scope.test.ts",
    "check:java": "vitest run plugins/java/tests",
    "check:lint-rules": "vitest run rules plugins/harness/tooling/pnpm plugins/harness/tests",
    "check:markdownlint-cli2": "markdownlint-cli2 \"**/*.md\"",
    "check:promtool-release": "run-s test:promtool:release test:promtool:models",
    "check:sdd": "vitest run plugins/spec-driven-development/tests",
    "check:versions": "run-s versions:check versions:test",
    "versions:check": "node .github/scripts/sync-versions.mjs",
    "versions:test": "vitest run .github/scripts/sync-versions.test.ts",
    "versions:sync": "node .github/scripts/sync-versions.mjs --write",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "run-s ultracite:check ultracite:check:harness",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 \"**/*.md\" --fix",
    "fix:ultracite": "run-s ultracite:fix ultracite:fix:harness",
    "pre-commit": "run-p $(node --import tsx .github/scripts/pre-commit-scope.ts)",
    "pre-push": "run-s check",
    "prepare": "husky",
    "test:promtool": "tsx plugins/observability-assets/tests/promtool/run.ts",
    "test:promtool:release": "vitest run plugins/observability-assets/tests/promtool/release.test.ts",
    "test:promtool:models": "run-s test:promtool:model:*",
    "test:promtool:model:download": "model_dir=$(mktemp -d) && trap 'rm -rf \"$model_dir\"' EXIT && java -XX:+UseParallelGC -cp node_modules/tla-chaos-loop/tools/tla2tools.jar tlc2.TLC -workers 1 -metadir \"$model_dir\" -config plugins/observability-assets/tests/promtool/model/DownloadLifecycle.cfg plugins/observability-assets/tests/promtool/model/DownloadLifecycle.tla",
    "test:promtool:model:child": "model_dir=$(mktemp -d) && trap 'rm -rf \"$model_dir\"' EXIT && java -XX:+UseParallelGC -cp node_modules/tla-chaos-loop/tools/tla2tools.jar tlc2.TLC -workers 1 -metadir \"$model_dir\" -config plugins/observability-assets/tests/promtool/model/ChildLifecycle.cfg plugins/observability-assets/tests/promtool/model/ChildLifecycle.tla",
    "ultracite:check": "ultracite check --config oxlint.config.ts",
    "ultracite:check:harness": "ultracite check --type-aware --config plugins/harness/tooling/pnpm/oxlint.config.ts plugins/harness/tooling/pnpm",
    "ultracite:fix": "ultracite fix --config oxlint.config.ts",
    "ultracite:fix:harness": "ultracite fix --type-aware --config plugins/harness/tooling/pnpm/oxlint.config.ts plugins/harness/tooling/pnpm"
  },
  "devDependencies": {
    "@google/design.md": "catalog:",
    "@oxc-project/types": "catalog:",
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tar": "catalog:",
    "tla-chaos-loop": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "config": {
    "promtoolVersion": "3.13.5"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
