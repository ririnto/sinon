{
  "name": "sinon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rules/no-sensitive-content": "./plugins/harness/tooling/pnpm/rules/no-sensitive-content.mjs"
  },
  "scripts": {
    "check": "run-p check:*",
    "check:codegraph": "vitest run plugins/codegraph/tests",
    "check:java": "vitest run plugins/java/tests",
    "check:lint-rules": "vitest run rules plugins/harness/tooling/pnpm plugins/harness/tests --maxWorkers=1",
    "check:markdownlint-cli2": "markdownlint-cli2 \"**/*.md\"",
    "check:marketplace": "run-s marketplace:check marketplace:test",
    "check:promtool-release": "vitest run plugins/observability-assets/tests/promtool/release.test.ts",
    "check:sdd": "vitest run plugins/spec-driven-development/tests",
    "check:versions": "run-s versions:check versions:test",
    "versions:check": "node .github/scripts/sync-versions.mjs",
    "versions:test": "vitest run .github/scripts/sync-versions.test.ts",
    "versions:sync": "node .github/scripts/sync-versions.mjs --write",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "run-s ultracite:check ultracite:check:harness ultracite:check:marketplace",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 \"**/*.md\" --fix",
    "fix:ultracite": "run-s ultracite:fix ultracite:fix:harness",
    "marketplace:check": "node --import tsx .claude-plugin/marketplace/generate.ts --check",
    "marketplace:generate": "node --import tsx .claude-plugin/marketplace/generate.ts",
    "marketplace:test": "vitest run .claude-plugin/marketplace/generate.test.ts",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky",
    "test:promtool": "tsx plugins/observability-assets/tests/promtool/run.ts",
    "ultracite:check": "ultracite check --config oxlint.config.ts",
    "ultracite:check:harness": "ultracite check --config plugins/harness/tooling/pnpm/oxlint.config.ts plugins/harness/tooling/pnpm",
    "ultracite:check:marketplace": "ultracite check .claude-plugin/marketplace",
    "ultracite:fix": "ultracite fix --config oxlint.config.ts",
    "ultracite:fix:harness": "ultracite fix --config plugins/harness/tooling/pnpm/oxlint.config.ts plugins/harness/tooling/pnpm"
  },
  "devDependencies": {
    "@google/design.md": "catalog:",
    "@oxc-project/types": "catalog:",
    "@tsconfig/node26": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tar": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "config": {
    "promtoolVersion": "3.13.5"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
