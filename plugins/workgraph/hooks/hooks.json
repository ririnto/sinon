{
  "description": "Inject Workgraph contracts into main and subagent sessions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-context.mjs"],
            "timeout": 5,
            "statusMessage": "Loading Workgraph main contract"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-context.mjs"],
            "timeout": 5,
            "statusMessage": "Restoring Workgraph context"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-context.mjs"],
            "timeout": 5,
            "statusMessage": "Loading Workgraph node contract"
          }
        ]
      }
    ]
  }
}
