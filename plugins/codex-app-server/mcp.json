{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "codex-app-server": {
      "type": "stdio",
      "command": "npm",
      "args": [
        "exec",
        "--yes",
        "--install-links",
        "--package=.",
        "--",
        "codex-app-server"
      ],
      "env": { "NODE_USE_SYSTEM_CA": "1" },
      "cwd": "./"
    }
  }
}
