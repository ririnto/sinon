{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/refs/tags/v0.22.1/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "line-length": false,
    "no-inline-html": {
      "allowed_elements": [
        "details",
        "summary",
        "kbd",
        "img",
        "code"
      ],
      "table_allowed_elements": [
        "br"
      ]
    },
    "no-duplicate-heading": {
      "siblings_only": true
    },
    "code-block-style": {
      "style": "fenced"
    },
    "no-emphasis-as-heading": true,
    "docs/no-box-drawing": true,
    "docs/exec-plans/links": true,
    "docs/root-files": true
  },
  "customRules": [
    "./scripts/no-box-drawing.ts",
    "./scripts/exec-plan-links.ts",
    "./scripts/docs-root-files.ts"
  ],
  "gitignore": ".gitignore",
  "globs": [
    "**/*.md"
  ]
}
