{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/refs/tags/v0.23.0/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "line-length": false,
    "first-line-heading": false,
    "no-inline-html": {
      "allowed_elements": ["details", "summary", "kbd", "img", "code"],
      "table_allowed_elements": ["br"]
    },
    "no-duplicate-heading": {
      "siblings_only": true
    },
    "code-block-style": {
      "style": "fenced"
    },
    "no-emphasis-as-heading": true,
    "docs/no-box-drawing": true,
    "docs/exec-plans/links": true
  },
  "customRules": ["./rules/no-box-drawing.ts", "./rules/exec-plan-links.ts"],
  "gitignore": ".gitignore",
  "globs": ["**/*.md"]
}
