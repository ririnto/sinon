{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ririnto/sinon/plugins/harness/manifest.base.schema.json",
  "title": "RepositoryHarnessManifestBase",
  "description": "Base schema for docs/harness/manifest.json. Common to every stack including shell. Every check add-on entry follows the uniform shape: { description, enabled, severity, messages, parameters }. Stack-specific schemas extend this base by composing it via allOf. The harness is not versioned; the current committed manifest is the only authoritative shape. Unknown top-level keys are logged as WARN by the validator's main routine. The docContent add-on supports nested condition/when expressions inside parameters.checks using allOf, anyOf, contains, and not while preserving the uniform add-on shape.",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/addOn"
  },
  "required": [
    "name",
    "description"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "filePresence": {
      "$ref": "#/$defs/addOn"
    },
    "directoryPresence": {
      "$ref": "#/$defs/addOn"
    },
    "emptyDirectoryPlaceholders": {
      "$ref": "#/$defs/addOn"
    },
    "scaffoldLeaks": {
      "$ref": "#/$defs/addOn"
    },
    "hookShebang": {
      "$ref": "#/$defs/addOn"
    },
    "hookExecutable": {
      "$ref": "#/$defs/addOn"
    },
    "uncheckedTasks": {
      "$ref": "#/$defs/addOn"
    },
    "seedFiles": {
      "$ref": "#/$defs/metadata"
    },
    "generatedArtifacts": {
      "$ref": "#/$defs/metadata"
    },
    "harnessEvolution": {
      "$ref": "#/$defs/metadata"
    },
    "teamPatterns": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "severity": {
      "enum": [
        "ERROR",
        "WARN",
        "INFO"
      ]
    },
    "fixSafety": {
      "enum": [
        "safe",
        "unsafe",
        "manual"
      ]
    },
    "addOn": {
      "type": "object",
      "description": "Uniform shape for every check add-on. `parameters` is free-form per add-on; `messages` maps named template keys to user-visible failure messages.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Informational metadata; not validated by the harness.",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
