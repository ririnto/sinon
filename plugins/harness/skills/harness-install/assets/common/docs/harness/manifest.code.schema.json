{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ririnto/sinon/plugins/harness/manifest.code.schema.json",
  "title": "RepositoryHarnessManifestCode",
  "description": "Code-stack tier (gradle/maven/bun/uv). Extends manifest.base.schema.json with rules that require AST/CST parsing or text scanning over source files. Stack-specific schemas extend this tier via allOf.",
  "allOf": [
    {
      "$ref": "./manifest.base.schema.json"
    }
  ],
  "properties": {
    "templateGroups": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "docHeadings": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "docContent": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "agentFrontmatter": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "skillFrontmatter": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "hookGeneratedMarker": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "hookStage": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "hookCommand": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "ciHookCommandParity": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "envShebangUsage": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "shebangEncodingMarker": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "symlinkSafety": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "earlyReturn": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "emptyCatchBlock": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "greaterThanComparison": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "importOverFqn": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "leafFunctionBlankLines": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "publicDeclarationDocComment": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "silentCatch": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "unstructuredLogging": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "wildcardImport": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    }
  }
}
