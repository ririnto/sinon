{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryHarnessManifestGradle",
  "description": "Gradle stack (Kotlin-only) manifest schema. Self-contained; no external references. Includes infrastructure checks, code-tier rules, and Kotlin-specific rules (implicitLambdaIt, kotlinTopLevelDeclarationCount, companionObjectPosition, nonNullAssertion, uncheckedCastSuppression, terminalBranchWhen).",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/addOn"
  },
  "required": [
    "name",
    "description"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "filePresence": {
      "$ref": "#/$defs/addOn"
    },
    "directoryPresence": {
      "$ref": "#/$defs/addOn"
    },
    "emptyDirectoryPlaceholders": {
      "$ref": "#/$defs/addOn"
    },
    "scaffoldLeaks": {
      "$ref": "#/$defs/addOn"
    },
    "hookShebang": {
      "$ref": "#/$defs/addOn"
    },
    "hookExecutable": {
      "$ref": "#/$defs/addOn"
    },
    "uncheckedTasks": {
      "$ref": "#/$defs/addOn"
    },
    "seedFiles": {
      "$ref": "#/$defs/metadata"
    },
    "generatedArtifacts": {
      "$ref": "#/$defs/metadata"
    },
    "harnessEvolution": {
      "$ref": "#/$defs/metadata"
    },
    "teamPatterns": {
      "$ref": "#/$defs/metadata"
    },
    "templateGroups": {
      "$ref": "#/$defs/addOn"
    },
    "docHeadings": {
      "$ref": "#/$defs/addOn"
    },
    "docContent": {
      "$ref": "#/$defs/addOn"
    },
    "agentFrontmatter": {
      "$ref": "#/$defs/addOn"
    },
    "skillFrontmatter": {
      "$ref": "#/$defs/addOn"
    },
    "hookGeneratedMarker": {
      "$ref": "#/$defs/addOn"
    },
    "hookStage": {
      "$ref": "#/$defs/hookStageAddOn"
    },
    "hookCommand": {
      "$ref": "#/$defs/hookCommandAddOn"
    },
    "ciHookCommandParity": {
      "$ref": "#/$defs/addOn"
    },
    "envShebangUsage": {
      "$ref": "#/$defs/addOn"
    },
    "symlinkSafety": {
      "$ref": "#/$defs/addOn"
    },
    "leafFunctionBlankLines": {
      "$ref": "#/$defs/addOn"
    },
    "unstructuredLogging": {
      "$ref": "#/$defs/loggingAddOn"
    },
    "importOverFqn": {
      "$ref": "#/$defs/importOverFqnAddOn"
    },
    "implicitLambdaIt": {
      "$ref": "#/$defs/addOn"
    },
    "kotlinTopLevelDeclarationCount": {
      "$ref": "#/$defs/kotlinTopLevelDeclarationCountAddOn"
    },
    "companionObjectPosition": {
      "$ref": "#/$defs/addOn"
    },
    "nonNullAssertion": {
      "$ref": "#/$defs/addOn"
    },
    "ifStatementBraces": {
      "$ref": "#/$defs/addOn"
    },
    "uncheckedCastSuppression": {
      "$ref": "#/$defs/suppressionAddOn"
    },
    "terminalBranchWhen": {
      "$ref": "#/$defs/addOn"
    },
    "publicDeclarationDocComment": {
      "$ref": "#/$defs/publicDeclarationDocCommentAddOn"
    },
    "leadingUnderscore": {
      "$ref": "#/$defs/leadingUnderscoreAddOn"
    },
    "multilineDocStyle": {
      "$ref": "#/$defs/multilineDocStyleAddOn"
    }
  },
  "$defs": {
    "severity": {
      "enum": [
        "ERROR",
        "WARN",
        "INFO"
      ]
    },
    "fixSafety": {
      "enum": [
        "safe",
        "unsafe",
        "manual"
      ]
    },
    "addOn": {
      "type": "object",
      "description": "Uniform shape for every check add-on. `parameters` is free-form per add-on; `messages` maps named template keys to user-visible failure messages.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Informational metadata; not validated by the harness.",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "sourceScope": {
      "type": "object",
      "properties": {
        "sourceRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "enum": [
              "kt",
              "kts"
            ]
          }
        },
        "includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "loggingAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "forbiddenLoggingApis": {
                      "$ref": "#/$defs/stringList"
                    },
                    "allowedLoggingApis": {
                      "$ref": "#/$defs/stringList"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "importOverFqnAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "allowedFqnPatterns": {
                      "$ref": "#/$defs/stringList"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "suppressionAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "forbiddenSuppressions": {
                      "$ref": "#/$defs/stringList"
                    },
                    "allowedSuppressions": {
                      "$ref": "#/$defs/stringList"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "publicDeclarationDocCommentAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "visibility": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "public",
                          "protected",
                          "internal",
                          "private"
                        ]
                      }
                    },
                    "allowedDeclarationKinds": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "class",
                          "function",
                          "property"
                        ]
                      }
                    },
                    "exemptOverrideDeclarations": {
                      "type": "boolean"
                    },
                    "exemptLocalDeclarations": {
                      "type": "boolean"
                    },
                    "docStyleMode": {
                      "enum": [
                        "multiline"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "leadingUnderscoreAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "allowedNames": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "allowedPatterns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "multilineDocStyleAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "docStyleMode": {
                      "enum": [
                        "multiline"
                      ]
                    },
                    "formatterRequiredExceptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "kotlinTopLevelDeclarationCountAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "allowedDeclarations": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "class",
                          "interface",
                          "enum class",
                          "data class",
                          "sealed class",
                          "object",
                          "abstract class",
                          "typealias"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "hookStageAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "type": "object",
              "properties": {
                "markerTemplate": {
                  "type": "string"
                },
                "stages": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pre-commit",
                    "pre-push"
                  ],
                  "properties": {
                    "pre-commit": {
                      "type": "string"
                    },
                    "pre-push": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "hookCommandAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "type": "object",
              "properties": {
                "prePushHook": {
                  "type": "string"
                },
                "preCommitHook": {
                  "type": "string"
                },
                "allowedCommands": {
                  "$ref": "#/$defs/stringList"
                },
                "allowedPreCommitCommands": {
                  "$ref": "#/$defs/stringList"
                }
              }
            }
          }
        }
      ]
    }
  }
}
