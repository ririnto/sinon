{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ririnto/sinon/plugins/harness/manifest.gradle.schema.json",
  "title": "RepositoryHarnessManifestGradle",
  "description": "Gradle stack manifest schema. Extends manifest.code.schema.json with JVM-shared rules (classMemberOrdering, ifStatementBraces, mutableCollection), declaration/doc rules, and Kotlin-specific rules (implicitLambdaIt, kotlinTopLevelDeclarationCount, companionObjectPosition, nonNullAssertion, uncheckedCastSuppression, terminalBranchWhen).",
  "allOf": [
    {
      "$ref": "./manifest.code.schema.json"
    }
  ],
  "properties": {
    "classMemberOrdering": {
      "$ref": "#/$defs/classMemberOrderingAddOn"
    },
    "ifStatementBraces": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "mutableCollection": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "unstructuredLogging": {
      "$ref": "#/$defs/loggingAddOn"
    },
    "importOverFqn": {
      "$ref": "#/$defs/importOverFqnAddOn"
    },
    "implicitLambdaIt": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "kotlinTopLevelDeclarationCount": {
      "$ref": "#/$defs/kotlinTopLevelDeclarationCountAddOn"
    },
    "companionObjectPosition": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "nonNullAssertion": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "uncheckedCastSuppression": {
      "$ref": "#/$defs/suppressionAddOn"
    },
    "terminalBranchWhen": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "publicDeclarationDocComment": {
      "$ref": "#/$defs/publicDeclarationDocCommentAddOn"
    },
    "leadingUnderscore": {
      "$ref": "#/$defs/leadingUnderscoreAddOn"
    },
    "multilineDocStyle": {
      "$ref": "#/$defs/multilineDocStyleAddOn"
    }
  },
  "$defs": {
    "sourceScope": {
      "type": "object",
      "properties": {
        "sourceRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "enum": [
              "kt",
              "kts"
            ]
          }
        },
        "includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memberKind": {
      "enum": [
        "companionObject",
        "constProperty",
        "fieldOrProperty",
        "initializer",
        "constructor",
        "function",
        "interface",
        "class",
        "enum"
      ]
    },
    "memberOrderEntry": {
      "anyOf": [
        {
          "$ref": "#/$defs/memberKind"
        },
        {
          "pattern": "^(public|protected|internal|package|private):(companionObject|constProperty|fieldOrProperty|initializer|constructor|function|interface|class|enum)$"
        },
        {
          "pattern": "^(nonOverride|override):(public|protected|internal|package|private):(companionObject|constProperty|fieldOrProperty|initializer|constructor|function|interface|class|enum)$"
        }
      ]
    },
    "classMemberOrderingAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "type": "object",
              "properties": {
                "sourceRoots": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "extensions": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "java",
                      "kt",
                      "kts"
                    ]
                  }
                },
                "includePaths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "excludePaths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "order": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/memberOrderEntry"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "loggingAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "forbiddenLoggingApis": {
                      "$ref": "#/$defs/stringList"
                    },
                    "allowedLoggingApis": {
                      "$ref": "#/$defs/stringList"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "importOverFqnAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "allowedFqnPatterns": {
                      "$ref": "#/$defs/stringList"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "suppressionAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "forbiddenSuppressions": {
                      "$ref": "#/$defs/stringList"
                    },
                    "allowedSuppressions": {
                      "$ref": "#/$defs/stringList"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "publicDeclarationDocCommentAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "visibility": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "public",
                          "protected",
                          "internal",
                          "private"
                        ]
                      }
                    },
                    "allowedDeclarationKinds": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "class",
                          "function",
                          "property"
                        ]
                      }
                    },
                    "exemptOverrideDeclarations": {
                      "type": "boolean"
                    },
                    "exemptLocalDeclarations": {
                      "type": "boolean"
                    },
                    "docStyleMode": {
                      "enum": [
                        "multiline"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "leadingUnderscoreAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "allowedNames": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "allowedPatterns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "pythonDunderExemptions": {
                      "const": false
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "multilineDocStyleAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "docStyleMode": {
                      "enum": [
                        "multiline"
                      ]
                    },
                    "formatterRequiredExceptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "kotlinTopLevelDeclarationCountAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "allowedDeclarations": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "class",
                          "interface",
                          "enum class",
                          "data class",
                          "sealed class",
                          "object",
                          "abstract class",
                          "typealias"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
