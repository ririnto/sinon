root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_code_style_defaults = KOTLIN_STYLE_GUIDE

ktlint_multiline_doc_style_mode = multiline
ktlint_companion_object_position_position = top
