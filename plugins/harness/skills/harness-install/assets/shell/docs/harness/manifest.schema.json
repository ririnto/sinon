{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryHarnessManifestShell",
  "description": "Self-contained shell stack manifest schema for docs/harness/manifest.json. Defines typed parameter shapes for shell-specific rules: executable path lists, hook file rules, POSIX shell policy, shell runtime scope, generated-artifact patterns, and Markdown fence policy for shell-owned docs/templates. No external schema dependencies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "filePresence": {
      "$ref": "#/$defs/addOnWithPaths"
    },
    "directoryPresence": {
      "$ref": "#/$defs/addOnWithPaths"
    },
    "emptyDirectoryPlaceholders": {
      "$ref": "#/$defs/addOnWithDirectories"
    },
    "scaffoldLeaks": {
      "$ref": "#/$defs/addOnWithScaffoldScope"
    },
    "hookShebang": {
      "$ref": "#/$defs/addOnWithHookShebang"
    },
    "hookExecutable": {
      "$ref": "#/$defs/addOnWithHookList"
    },
    "hookCommand": {
      "$ref": "#/$defs/addOnWithHookCommand"
    },
    "ciHookCommandParity": {
      "$ref": "#/$defs/addOnWithCiHookCommandParity"
    },
    "uncheckedTasks": {
      "$ref": "#/$defs/addOnWithUncheckedTasks"
    },
    "symlinkSafety": {
      "$ref": "#/$defs/addOnWithSymlinkSafety"
    },
    "shellcheck": {
      "$ref": "#/$defs/addOnWithShellcheck"
    },
    "seedFiles": {
      "$ref": "#/$defs/metadata"
    },
    "generatedArtifacts": {
      "$ref": "#/$defs/metadata"
    },
    "harnessEvolution": {
      "$ref": "#/$defs/metadata"
    },
    "teamPatterns": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "severity": {
      "enum": [
        "ERROR",
        "WARN",
        "INFO"
      ]
    },
    "fixSafety": {
      "enum": [
        "safe",
        "unsafe",
        "manual"
      ]
    },
    "addOnWithPaths": {
      "type": "object",
      "description": "Add-on with a typed paths array parameter.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paths"
          ],
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "List of required file or directory paths relative to the target repository root."
            }
          }
        }
      }
    },
    "addOnWithDirectories": {
      "type": "object",
      "description": "Add-on with a typed directories array parameter.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directories"
          ],
          "properties": {
            "directories": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Directories that must contain at least one real file or a .gitkeep placeholder."
            }
          }
        }
      }
    },
    "addOnWithScaffoldScope": {
      "type": "object",
      "description": "Add-on with typed scaffold leak scope and pattern parameters.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "patterns"
          ],
          "properties": {
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bases",
                "extensions"
              ],
              "properties": {
                "bases": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Root paths to scan for scaffold leaks."
                },
                "excludedSubtrees": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Subtrees excluded from scaffold leak scanning."
                },
                "extensions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "File extensions to include in scanning."
                }
              }
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pattern",
                  "label"
                ],
                "properties": {
                  "pattern": {
                    "type": "string",
                    "description": "Regex pattern to detect."
                  },
                  "label": {
                    "type": "string",
                    "description": "Human-readable label for the pattern match."
                  }
                }
              },
              "description": "Scaffold leak patterns to detect."
            }
          }
        }
      }
    },
    "addOnWithHookShebang": {
      "type": "object",
      "description": "Add-on with typed hook shebang parameters.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hooks",
            "expectedShebang"
          ],
          "properties": {
            "hooks": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Hook file paths to validate."
            },
            "expectedShebang": {
              "type": "string",
              "description": "Required first-line shebang for hook files."
            }
          }
        }
      }
    },
    "addOnWithHookList": {
      "type": "object",
      "description": "Add-on with typed hook executable list parameter.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hooks"
          ],
          "properties": {
            "hooks": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Hook file paths that must have executable bit set."
            }
          }
        }
      }
    },
    "addOnWithHookCommand": {
      "type": "object",
      "description": "Add-on with typed hook command parity parameters.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prePushHook",
            "preCommitHook",
            "allowedCommands",
            "allowedPreCommitCommands"
          ],
          "properties": {
            "prePushHook": {
              "type": "string",
              "description": "Generated pre-push hook path."
            },
            "preCommitHook": {
              "type": "string",
              "description": "Generated pre-commit hook path."
            },
            "allowedCommands": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Final validation commands the pre-push hook may declare and run."
            },
            "allowedPreCommitCommands": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Intermediate validation commands the pre-commit hook may run. Empty means no full-stack validation command is allowed."
            }
          }
        }
      }
    },
    "addOnWithCiHookCommandParity": {
      "type": "object",
      "description": "Add-on with typed CI to hook command parity parameters.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ciFiles",
            "referenceHook"
          ],
          "properties": {
            "ciFiles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "CI files that should contain the generated pre-push command when present."
            },
            "referenceHook": {
              "type": "string",
              "description": "Hook file whose declared validation command is authoritative for CI."
            }
          }
        }
      }
    },
    "addOnWithUncheckedTasks": {
      "type": "object",
      "description": "Add-on with typed unchecked task parameters.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directory",
            "uncheckedTaskPattern"
          ],
          "properties": {
            "directory": {
              "type": "string",
              "description": "Directory containing completed plan files."
            },
            "filenamePattern": {
              "type": "string",
              "description": "Glob pattern for plan filenames."
            },
            "uncheckedTaskPattern": {
              "type": "string",
              "description": "Regex pattern matching unchecked task lines."
            }
          }
        }
      }
    },
    "addOnWithShellcheck": {
      "type": "object",
      "description": "Add-on for shellcheck validation of shell scripts.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "addOnWithSymlinkSafety": {
      "type": "object",
      "description": "Add-on with typed allowed symlink-pair parameters.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedSymlinkPairs"
          ],
          "properties": {
            "allowedSymlinkPairs": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "description": "Bidirectional root-level symlink pairs allowed by the harness contract."
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Informational metadata; not validated by the harness.",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
