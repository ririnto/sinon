<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>my-project</artifactId>
  <version>1.0.0</version>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <java>
            <palantirJavaFormat/>
            <importOrder>
              <order>java,javax,org,com</order>
            </importOrder>
            <removeUnusedImports/>
            <formatAnnotations/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>sync-git-hooks</id>
            <phase>validate</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <exec executable="sh" failonerror="false">
                  <arg value="-c"/>
                  <arg value="hooks_dir=$(git rev-parse --git-path hooks 2&gt;&amp;1) || exit 0; mkdir -p &quot;$hooks_dir&quot;; for name in pre-commit pre-push; do src=&quot;docs/harness/git-hooks/$name&quot;; if [ -f &quot;$src&quot; ]; then dst=&quot;$hooks_dir/$name&quot;; if [ ! -L &quot;$dst&quot; ] &amp;&amp; [ -f &quot;$dst&quot; ] &amp;&amp; cmp -s &quot;$src&quot; &quot;$dst&quot;; then continue; fi; tmp=&quot;$hooks_dir/.sync-git-hooks-$$-$name&quot;; cp &quot;$src&quot; &quot;$tmp&quot; &amp;&amp; chmod 755 &quot;$tmp&quot; &amp;&amp; mv &quot;$tmp&quot; &quot;$dst&quot;; fi; done"/>
                </exec>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
