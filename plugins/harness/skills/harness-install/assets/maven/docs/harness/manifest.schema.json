{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryHarnessManifestMaven",
  "description": "Maven stack manifest schema for Java-only projects. Contains only Java-applicable rules (classMemberOrdering, ifStatementBraces, etc.). Does not include Kotlin, Python, or TypeScript language-specific rules.",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/addOn"
  },
  "required": [
    "name",
    "description"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "filePresence": {
      "$ref": "#/$defs/addOn"
    },
    "directoryPresence": {
      "$ref": "#/$defs/addOn"
    },
    "emptyDirectoryPlaceholders": {
      "$ref": "#/$defs/addOn"
    },
    "scaffoldLeaks": {
      "$ref": "#/$defs/addOn"
    },
    "hookShebang": {
      "$ref": "#/$defs/addOn"
    },
    "hookExecutable": {
      "$ref": "#/$defs/addOn"
    },
    "uncheckedTasks": {
      "$ref": "#/$defs/addOn"
    },
    "seedFiles": {
      "$ref": "#/$defs/metadata"
    },
    "generatedArtifacts": {
      "$ref": "#/$defs/metadata"
    },
    "harnessEvolution": {
      "$ref": "#/$defs/metadata"
    },
    "teamPatterns": {
      "$ref": "#/$defs/metadata"
    },
    "templateGroups": {
      "$ref": "#/$defs/addOn"
    },
    "docHeadings": {
      "$ref": "#/$defs/addOn"
    },
    "docContent": {
      "$ref": "#/$defs/addOn"
    },
    "agentFrontmatter": {
      "$ref": "#/$defs/addOn"
    },
    "skillFrontmatter": {
      "$ref": "#/$defs/addOn"
    },
    "hookGeneratedMarker": {
      "$ref": "#/$defs/addOn"
    },
    "hookStage": {
      "$ref": "#/$defs/addOn"
    },
    "hookCommand": {
      "$ref": "#/$defs/addOn"
    },
    "ciHookCommandParity": {
      "$ref": "#/$defs/addOn"
    },
    "envShebangUsage": {
      "$ref": "#/$defs/addOn"
    },
    "shebangEncodingMarker": {
      "$ref": "#/$defs/addOn"
    },
    "symlinkSafety": {
      "$ref": "#/$defs/addOn"
    },
    "earlyReturn": {
      "$ref": "#/$defs/addOn"
    },
    "emptyCatchBlock": {
      "$ref": "#/$defs/addOn"
    },
    "greaterThanComparison": {
      "$ref": "#/$defs/addOn"
    },
    "importOverFqn": {
      "$ref": "#/$defs/addOn"
    },
    "leafFunctionBlankLines": {
      "$ref": "#/$defs/addOn"
    },
    "publicDeclarationDocComment": {
      "$ref": "#/$defs/addOn"
    },
    "silentCatch": {
      "$ref": "#/$defs/addOn"
    },
    "unstructuredLogging": {
      "$ref": "#/$defs/addOn"
    },
    "wildcardImport": {
      "$ref": "#/$defs/addOn"
    },
    "classMemberOrdering": {
      "$ref": "#/$defs/classMemberOrderingAddOn"
    },
    "leadingUnderscore": {
      "$ref": "#/$defs/leadingUnderscoreAddOn"
    },
    "multilineDocStyle": {
      "$ref": "#/$defs/multilineDocStyleAddOn"
    }
  },
  "$defs": {
    "severity": {
      "enum": [
        "ERROR",
        "WARN",
        "INFO"
      ]
    },
    "fixSafety": {
      "enum": [
        "safe",
        "unsafe",
        "manual"
      ]
    },
    "addOn": {
      "type": "object",
      "description": "Uniform shape for every check add-on. `parameters` is free-form per add-on; `messages` maps named template keys to user-visible failure messages.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Informational metadata; not validated by the harness.",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "sourceScope": {
      "type": "object",
      "properties": {
        "sourceRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "const": "java"
          }
        },
        "includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classMemberOrderingAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "kindOrder": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "companionObject",
                          "constProperty",
                          "fieldOrProperty",
                          "initializer",
                          "constructor",
                          "function",
                          "interface",
                          "class",
                          "enum"
                        ]
                      }
                    },
                    "visibilityOrder": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "public",
                          "protected",
                          "package",
                          "private"
                        ]
                      }
                    },
                    "overrideOrder": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "override",
                          "nonOverride"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "leadingUnderscoreAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "allowedNames": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "allowedPatterns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "multilineDocStyleAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "docStyleMode": {
                      "enum": [
                        "multiline"
                      ]
                    },
                    "formatterRequiredExceptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
