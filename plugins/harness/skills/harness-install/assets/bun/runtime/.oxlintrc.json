{
  "$schema": "https://oxc.rs/oxlint.schema.json",
  "plugins": ["import", "typescript"],
  "jsPlugins": ["./oxlint-plugins/harness.mjs"],
  "rules": {
    "eslint/no-console": "error",
    "eslint/no-empty": ["error", { "allowEmptyCatch": false }],
    "eslint/curly": "error",
    "eslint/no-underscore-dangle": ["error", { "allow": ["_"] }],
    "import/no-namespace": "error",
    "typescript/ban-ts-comment": "error",
    "harness/greaterThanComparison": "error",
    "harness/earlyReturn": "error",
    "harness/silentCatch": "error",
    "harness/importOverFqn": "error",
    "harness/multilineDocStyle": "error",
    "harness/publicDeclarationDocComment": "error"
  }
}
