{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ririnto/sinon/plugins/harness/manifest.bun.schema.json",
  "title": "RepositoryHarnessManifestBun",
  "description": "Bun stack manifest schema. Extends manifest.code.schema.json with TypeScript/JavaScript rules (ifStatementBraces, mutableCollection) and TypeScript declaration/doc rules.",
  "allOf": [
    {
      "$ref": "./manifest.code.schema.json"
    }
  ],
  "properties": {
    "ifStatementBraces": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "mutableCollection": {
      "$ref": "./manifest.base.schema.json#/$defs/addOn"
    },
    "unstructuredLogging": {
      "$ref": "#/$defs/loggingAddOn"
    },
    "importOverFqn": {
      "$ref": "#/$defs/importOverFqnAddOn"
    },
    "uncheckedCastSuppression": {
      "$ref": "#/$defs/suppressionAddOn"
    },
    "publicDeclarationDocComment": {
      "$ref": "#/$defs/publicDeclarationDocCommentAddOn"
    },
    "leadingUnderscore": {
      "$ref": "#/$defs/leadingUnderscoreAddOn"
    },
    "multilineDocStyle": {
      "$ref": "#/$defs/multilineDocStyleAddOn"
    }
  },
  "$defs": {
    "sourceScope": {
      "type": "object",
      "properties": {
        "sourceRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "enum": [
              "ts",
              "tsx"
            ]
          }
        },
        "includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "loggingAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "forbiddenLoggingApis": {
                      "$ref": "#/$defs/stringList"
                    },
                    "allowedLoggingApis": {
                      "$ref": "#/$defs/stringList"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "importOverFqnAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "allowedFqnPatterns": {
                      "$ref": "#/$defs/stringList"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "suppressionAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "forbiddenSuppressions": {
                      "$ref": "#/$defs/stringList"
                    },
                    "allowedSuppressions": {
                      "$ref": "#/$defs/stringList"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "publicDeclarationDocCommentAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "visibility": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "export"
                        ]
                      }
                    },
                    "allowedDeclarationKinds": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "class",
                          "function",
                          "interface",
                          "typeAlias",
                          "variable"
                        ]
                      }
                    },
                    "exemptOverrideDeclarations": {
                      "type": "boolean"
                    },
                    "exemptLocalDeclarations": {
                      "type": "boolean"
                    },
                    "docStyleMode": {
                      "enum": [
                        "multiline"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "leadingUnderscoreAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "allowedNames": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "allowedPatterns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "pythonDunderExemptions": {
                      "const": false
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "multilineDocStyleAddOn": {
      "allOf": [
        {
          "$ref": "./manifest.base.schema.json#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "docStyleMode": {
                      "enum": [
                        "multiline"
                      ]
                    },
                    "formatterRequiredExceptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
