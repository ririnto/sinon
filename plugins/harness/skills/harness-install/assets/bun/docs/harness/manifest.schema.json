{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryHarnessManifestBun",
  "description": "Bun stack (TypeScript/JavaScript) manifest schema. Self-contained with inlined base and code-stack definitions. Defines validation rules for TS/JS source files, harness structure, and documentation.",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/addOn"
  },
  "required": [
    "name",
    "description"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "filePresence": {
      "$ref": "#/$defs/addOn"
    },
    "directoryPresence": {
      "$ref": "#/$defs/addOn"
    },
    "emptyDirectoryPlaceholders": {
      "$ref": "#/$defs/addOn"
    },
    "scaffoldLeaks": {
      "$ref": "#/$defs/addOn"
    },
    "hookShebang": {
      "$ref": "#/$defs/addOn"
    },
    "hookExecutable": {
      "$ref": "#/$defs/addOn"
    },
    "uncheckedTasks": {
      "$ref": "#/$defs/addOn"
    },
    "templateGroups": {
      "$ref": "#/$defs/addOn"
    },
    "docHeadings": {
      "$ref": "#/$defs/addOn"
    },
    "docContent": {
      "$ref": "#/$defs/addOn"
    },
    "agentFrontmatter": {
      "$ref": "#/$defs/addOn"
    },
    "skillFrontmatter": {
      "$ref": "#/$defs/addOn"
    },
    "hookGeneratedMarker": {
      "$ref": "#/$defs/addOn"
    },
    "hookStage": {
      "$ref": "#/$defs/addOn"
    },
    "hookCommand": {
      "$ref": "#/$defs/addOn"
    },
    "ciHookCommandParity": {
      "$ref": "#/$defs/addOn"
    },
    "envShebangUsage": {
      "$ref": "#/$defs/addOn"
    },
    "shebangEncodingMarker": {
      "$ref": "#/$defs/addOn"
    },
    "symlinkSafety": {
      "$ref": "#/$defs/addOn"
    },
    "earlyReturn": {
      "$ref": "#/$defs/addOn"
    },
    "emptyCatchBlock": {
      "$ref": "#/$defs/addOn"
    },
    "greaterThanComparison": {
      "$ref": "#/$defs/addOn"
    },
    "ifStatementBraces": {
      "$ref": "#/$defs/addOn"
    },
    "mutableCollection": {
      "$ref": "#/$defs/addOn"
    },
    "unstructuredLogging": {
      "$ref": "#/$defs/loggingAddOn"
    },
    "importOverFqn": {
      "$ref": "#/$defs/importOverFqnAddOn"
    },
    "uncheckedCastSuppression": {
      "$ref": "#/$defs/suppressionAddOn"
    },
    "publicDeclarationDocComment": {
      "$ref": "#/$defs/publicDeclarationDocCommentAddOn"
    },
    "leadingUnderscore": {
      "$ref": "#/$defs/leadingUnderscoreAddOn"
    },
    "multilineDocStyle": {
      "$ref": "#/$defs/multilineDocStyleAddOn"
    },
    "leafFunctionBlankLines": {
      "$ref": "#/$defs/addOn"
    },
    "wildcardImport": {
      "$ref": "#/$defs/addOn"
    },
    "silentCatch": {
      "$ref": "#/$defs/addOn"
    },
    "seedFiles": {
      "$ref": "#/$defs/metadata"
    },
    "generatedArtifacts": {
      "$ref": "#/$defs/metadata"
    },
    "harnessEvolution": {
      "$ref": "#/$defs/metadata"
    },
    "teamPatterns": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "severity": {
      "enum": [
        "ERROR",
        "WARN",
        "INFO"
      ]
    },
    "fixSafety": {
      "enum": [
        "safe",
        "unsafe",
        "manual"
      ]
    },
    "addOn": {
      "type": "object",
      "description": "Uniform shape for every check add-on. `parameters` is free-form per add-on; `messages` maps named template keys to user-visible failure messages.",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Informational metadata; not validated by the harness.",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "sourceScope": {
      "type": "object",
      "properties": {
        "sourceRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "enum": [
              "ts",
              "tsx",
              "js",
              "jsx",
              "mts",
              "cts",
              "mjs",
              "cjs"
            ]
          }
        },
        "includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "loggingAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "forbiddenLoggingApis": {
                      "$ref": "#/$defs/stringList"
                    },
                    "allowedLoggingApis": {
                      "$ref": "#/$defs/stringList"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "importOverFqnAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "allowedFqnPatterns": {
                      "$ref": "#/$defs/stringList"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "suppressionAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "forbiddenSuppressions": {
                      "$ref": "#/$defs/stringList"
                    },
                    "allowedSuppressions": {
                      "$ref": "#/$defs/stringList"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "publicDeclarationDocCommentAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "visibility": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "export"
                        ]
                      }
                    },
                    "allowedDeclarationKinds": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "class",
                          "function",
                          "interface",
                          "typeAlias",
                          "variable"
                        ]
                      }
                    },
                    "exemptOverrideDeclarations": {
                      "type": "boolean"
                    },
                    "exemptLocalDeclarations": {
                      "type": "boolean"
                    },
                    "docStyleMode": {
                      "enum": [
                        "multiline"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "leadingUnderscoreAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "allowedNames": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "allowedPatterns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "multilineDocStyleAddOn": {
      "allOf": [
        {
          "$ref": "#/$defs/addOn"
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceScope"
                },
                {
                  "type": "object",
                  "properties": {
                    "docStyleMode": {
                      "enum": [
                        "multiline"
                      ]
                    },
                    "formatterRequiredExceptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
