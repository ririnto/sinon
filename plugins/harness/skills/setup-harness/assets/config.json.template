{
  "contractVersion": 1,
  "profile": {
    "name": "default",
    "stage": 1,
    "targetStage": 3,
    "level": "warn"
  },
  "paths": {
    "harnessRoot": "docs/harness-engineering",
    "config": "docs/harness-engineering/harness-engineering.json",
    "scriptsRoot": "scripts/harness",
    "validator": "scripts/harness/validate_harness.py",
    "wrapper": "scripts/harness/validate_harness.sh",
    "agentContextAlias": "AGENTS.md",
    "agentContextAliasTarget": "CLAUDE.md",
    "githubWorkflow": ".github/workflows/harness-checks.yml",
    "gitlabConfig": ".gitlab-ci.yml",
    "hooksRoot": ".githooks",
    "commitMsgHook": ".githooks/commit-msg",
    "prePushHook": ".githooks/pre-push"
  },
  "docs": {
    "agentContext": "CLAUDE.md",
    "architecture": "ARCHITECTURE.md",
    "guardrails": "docs/harness-engineering/guardrails.md",
    "updates": "docs/harness-engineering/updates.md"
  },
  "commands": {
    "required": [
      "sh scripts/harness/validate_harness.sh"
    ],
    "optional": []
  },
  "gates": {
    "ci": {
      "provider": "github-actions",
      "stage": 3,
      "branches": {
        "push": [
          "develop",
          "main",
          "master"
        ],
        "pullRequest": [
          "develop",
          "main",
          "master"
        ],
        "mergeRequest": [
          "develop",
          "main",
          "master"
        ]
      }
    },
    "hooks": {
      "enabled": false,
      "stage": 2
    }
  },
  "evidence": {
    "readiness": "docs/harness-engineering/readiness.md",
    "knownViolations": "docs/harness-engineering/known-violations.md",
    "generatedDocs": "docs/generated"
  },
  "packs": {
    "bun": {
      "enabled": false,
      "commands": [
        "bun scripts/harness/validate-harness.mjs"
      ],
      "paths": [
        "scripts/harness/validate-harness.mjs"
      ]
    },
    "gradle": {
      "enabled": false,
      "commands": [
        "./gradlew harnessCheck"
      ],
      "paths": [
        "build.gradle.kts"
      ]
    },
    "maven": {
      "enabled": false,
      "commands": [
        "mvn local.harness:harness-maven-plugin:harness-check"
      ],
      "paths": [
        "pom.xml"
      ]
    }
  },
  "absence": {
    "agentContextAlias": "required",
    "ci": "required",
    "hooks": "disabled",
    "packs": "disabled"
  }
}
