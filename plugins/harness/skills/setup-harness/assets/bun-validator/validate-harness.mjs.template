#!/usr/bin/env bun
import { existsSync, lstatSync, readFileSync, readlinkSync, realpathSync } from "node:fs";
import { isAbsolute, relative, resolve } from "node:path";

const CONTRACT_VERSION = 1;
const DEFAULT_CONFIG_PATH = "docs/harness-engineering/harness-engineering.json";
const SKILLS_ALIAS_PATH = ".agents/skills";
const SKILLS_ALIAS_TARGET = "../.claude/skills";
const REQUIRED_TOP_LEVEL = [
  "contractVersion",
  "profile",
  "paths",
  "docs",
  "commands",
  "gates",
  "evidence",
  "packs",
  "absence",
];
const REQUIRED_PROFILE = ["name", "stage", "targetStage", "level"];
const REQUIRED_PATHS = [
  "harnessRoot",
  "config",
  "scriptsRoot",
  "validator",
  "wrapper",
  "agentContextAlias",
  "agentContextAliasTarget",
  "githubWorkflow",
  "gitlabConfig",
  "hooksRoot",
  "commitMsgHook",
  "prePushHook",
];
const REQUIRED_DOCS = ["agentContext", "architecture", "guardrails", "updates"];
const REQUIRED_COMMANDS = ["required", "optional"];
const REQUIRED_GATES = ["ci", "hooks"];
const REQUIRED_CI_GATE = ["provider", "stage", "branches"];
const REQUIRED_HOOKS_GATE = ["enabled", "stage"];
const REQUIRED_EVIDENCE = ["readiness", "knownViolations", "generatedDocs"];
const REQUIRED_ABSENCE = ["agentContextAlias", "ci", "hooks", "packs"];
const REQUIRED_CI_PROVIDERS = ["github-actions", "gitlab-ci", "none"];
const REQUIRED_BRANCH_SETS = ["push", "pullRequest", "mergeRequest"];
const ENFORCEMENT_LEVELS = ["warn", "error"];
const ABSENCE_STATES = ["required", "optional", "disabled", "not-applicable", "pending-conflict"];
const REQUIRED_ALIAS_STATES = ["required", "optional", "pending-conflict", "not-applicable"];
const ACTIVE_ABSENCE_STATES = ["required", "optional"];
const INACTIVE_ABSENCE_STATES = ["disabled", "not-applicable", "pending-conflict"];
const PACK_NAME_PATTERN = /^[a-z0-9][a-z0-9-]*$/u;
const UNSAFE_COMMAND_PATTERN = /[;|&`$><\n]/u;
const TRUSTED_COMMAND_FORMS = [
  "sh scripts/harness/validate_harness.sh",
  "bun scripts/harness/validate-harness.mjs",
  "./gradlew harnessCheck",
  "mvn local.harness:harness-maven-plugin:harness-check",
];

/**
 * Parse command-line arguments for Bun-native harness validation.
 *
 * @param {string[]} args Command-line arguments after the Bun script path.
 * @returns {{ configPath: string, rootPath: string, templateMode: boolean }} Parsed validation options.
 */
function parseArgs(args) {
  const options = {
    configPath: process.env.HARNESS_CONFIG ?? DEFAULT_CONFIG_PATH,
    rootPath: process.env.HARNESS_ROOT ?? ".",
    templateMode: false,
  };
  for (let index = 0; index < args.length; index += 1) {
    if (args[index] === "--config" && index + 1 < args.length) {
      options.configPath = args[index + 1];
      index += 1;
    } else if (args[index] === "--root" && index + 1 < args.length) {
      options.rootPath = args[index + 1];
      index += 1;
    } else if (args[index] === "--template") {
      options.templateMode = true;
    } else {
      throw new Error(`unsupported argument: ${args[index]}`);
    }
  }
  return options;
}

/**
 * Return whether a config path is repository-relative and does not escape root.
 *
 * @param {unknown} value Config value to inspect.
 * @returns {boolean} Whether the value is a safe repository-relative path.
 */
function isRepoRelativePath(value) {
  return (
    typeof value === "string" &&
    value.length > 0 &&
    !value.includes("\\") &&
    !/^[A-Za-z]:/u.test(value) &&
    !value.startsWith("/") &&
    !value.startsWith("//") &&
    !value.split("/").includes("..")
  );
}

/**
 * Return whether a value is a plain JSON object.
 *
 * @param {unknown} value Value to inspect.
 * @returns {boolean} Whether the value is a JSON object.
 */
function isObject(value) {
  return Boolean(value) && typeof value === "object" && !Array.isArray(value);
}

/**
 * Validate a JSON object value.
 *
 * @param {Record<string, unknown>} root Parent object.
 * @param {string} field Field name.
 * @param {string[]} errors Validation errors.
 * @returns {Record<string, unknown> | undefined} Object value when valid.
 */
function objectField(root, field, errors) {
  if (!isObject(root[field])) {
    errors.push(`${field} must be an object`);
    return undefined;
  }
  return root[field];
}

/**
 * Return a dotted field value from a config object.
 *
 * @param {Record<string, unknown>} root Config object.
 * @param {string} dottedField Dotted field path.
 * @returns {unknown} Field value, or undefined when absent.
 */
function dottedValue(root, dottedField) {
  let current = root;
  for (const segment of dottedField.split(".")) {
    if (!isObject(current) || !(segment in current)) {
      return undefined;
    }
    current = current[segment];
  }
  return current;
}

/**
 * Return the active profile stage.
 *
 * @param {Record<string, unknown>} config Parsed harness config.
 * @returns {number} Current stage, or zero when invalid.
 */
function currentStage(config) {
  const stage = dottedValue(config, "profile.stage");
  return Number.isInteger(stage) ? stage : 0;
}

/**
 * Validate required object keys.
 *
 * @param {Record<string, unknown>} root Object to inspect.
 * @param {string[]} requiredFields Required field names.
 * @param {string} sectionName Section name for errors.
 * @returns {string[]} Validation errors.
 */
function validateRequiredFields(root, requiredFields, sectionName) {
  const errors = [];
  for (const field of requiredFields) {
    if (!(field in root)) {
      errors.push(`missing ${sectionName} field: ${field}`);
    }
  }
  return errors;
}

/**
 * Validate one string list field.
 *
 * @param {unknown} value Config value.
 * @param {string} fieldName Config field name.
 * @param {boolean} allowEmpty Whether an empty list is valid.
 * @returns {string[]} Validation errors.
 */
function validateStringList(value, fieldName, allowEmpty = false) {
  if (!Array.isArray(value)) {
    return [`${fieldName} must be a list of strings`];
  }
  if (!allowEmpty && value.length === 0) {
    return [`${fieldName} must be a non-empty list of strings`];
  }
  if (!value.every((item) => typeof item === "string" && item.length > 0)) {
    return [`${fieldName} must contain only non-empty strings`];
  }
  return [];
}

/**
 * Validate a configured command string without executing it.
 *
 * @param {unknown} command Configured command.
 * @param {string} fieldName Config field name for errors.
 * @returns {string[]} Validation errors.
 */
function validateCommand(command, fieldName) {
  if (typeof command !== "string") {
    return [`${fieldName} must be a command string`];
  }
  if (UNSAFE_COMMAND_PATTERN.test(command)) {
    return [`${fieldName} contains shell metacharacters: ${command}`];
  }
  if (!TRUSTED_COMMAND_FORMS.includes(command)) {
    return [`${fieldName} command is not an allowed argv form: ${command}`];
  }
  return [];
}

/**
 * Validate trusted command lists without executing them.
 *
 * @param {unknown} commands Configured command list.
 * @param {string} fieldName Config field name for errors.
 * @param {boolean} allowEmpty Whether an empty list is valid.
 * @returns {string[]} Validation errors.
 */
function validateCommands(commands, fieldName, allowEmpty = false) {
  if (!Array.isArray(commands)) {
    return [`${fieldName} must be a list of commands`];
  }
  if (!allowEmpty && commands.length === 0) {
    return [`${fieldName} must contain at least one command`];
  }
  const errors = [];
  for (const [index, command] of commands.entries()) {
    errors.push(...validateCommand(command, `${fieldName}[${index}]`));
  }
  return errors;
}

/**
 * Validate one repository-relative path field.
 *
 * @param {unknown} value Config path value.
 * @param {string} fieldName Config field name.
 * @returns {string[]} Validation errors.
 */
function validateRepoRelativePath(value, fieldName) {
  if (typeof value !== "string") {
    return [`${fieldName} must be a string path`];
  }
  if (!isRepoRelativePath(value)) {
    return [`${fieldName} must be a repository-relative path without '..': ${value}`];
  }
  return [];
}

/**
 * Validate a mapping whose values are repository-relative paths.
 *
 * @param {Record<string, unknown>} root Config section.
 * @param {string[]} fields Path field names.
 * @param {string} sectionName Config section name.
 * @returns {string[]} Validation errors.
 */
function validatePathMapping(root, fields, sectionName) {
  const errors = [];
  for (const field of fields) {
    if (field in root) {
      errors.push(...validateRepoRelativePath(root[field], `${sectionName}.${field}`));
    }
  }
  return errors;
}

/**
 * Validate the explicit machine-contract version.
 *
 * @param {Record<string, unknown>} root Config root.
 * @returns {string[]} Validation errors.
 */
function validateContractVersion(root) {
  return root.contractVersion === CONTRACT_VERSION ? [] : [`contractVersion must be ${CONTRACT_VERSION}`];
}

/**
 * Validate the adoption profile section.
 *
 * @param {Record<string, unknown>} profile Profile section.
 * @returns {string[]} Validation errors.
 */
function validateProfile(profile) {
  const errors = validateRequiredFields(profile, REQUIRED_PROFILE, "profile");
  if (typeof profile.name !== "string" || profile.name.length === 0) {
    errors.push("profile.name must be a non-empty string");
  }
  if (!Number.isInteger(profile.stage) || profile.stage < 0) {
    errors.push("profile.stage must be a non-negative integer");
  }
  if (!Number.isInteger(profile.targetStage) || profile.targetStage < 0) {
    errors.push("profile.targetStage must be a non-negative integer");
  }
  if (Number.isInteger(profile.stage) && Number.isInteger(profile.targetStage) && profile.stage > profile.targetStage) {
    errors.push("profile.stage must be less than or equal to profile.targetStage");
  }
  if (!ENFORCEMENT_LEVELS.includes(profile.level)) {
    errors.push(`profile.level must be one of: ${ENFORCEMENT_LEVELS.join(", ")}`);
  }
  return errors;
}

/**
 * Validate the machine-owned path registry.
 *
 * @param {Record<string, unknown>} paths Paths section.
 * @returns {string[]} Validation errors.
 */
function validatePathsSection(paths) {
  const errors = validateRequiredFields(paths, REQUIRED_PATHS, "paths");
  errors.push(...validatePathMapping(paths, REQUIRED_PATHS, "paths"));
  if (paths.config !== DEFAULT_CONFIG_PATH) {
    errors.push(`paths.config must be ${DEFAULT_CONFIG_PATH}`);
  }
  if (paths.harnessRoot !== "docs/harness-engineering") {
    errors.push("paths.harnessRoot must be docs/harness-engineering");
  }
  if (paths.agentContextAlias !== "AGENTS.md") {
    errors.push("paths.agentContextAlias must be AGENTS.md");
  }
  if (paths.agentContextAliasTarget !== "CLAUDE.md") {
    errors.push("paths.agentContextAliasTarget must be CLAUDE.md");
  }
  return errors;
}

/**
 * Validate Markdown policy and workflow document roles.
 *
 * @param {Record<string, unknown>} docs Docs section.
 * @returns {string[]} Validation errors.
 */
function validateDocsSection(docs) {
  const errors = validateRequiredFields(docs, REQUIRED_DOCS, "docs");
  errors.push(...validatePathMapping(docs, REQUIRED_DOCS, "docs"));
  if (docs.agentContext !== "CLAUDE.md") {
    errors.push("docs.agentContext must be CLAUDE.md");
  }
  if (docs.architecture !== "ARCHITECTURE.md") {
    errors.push("docs.architecture must be ARCHITECTURE.md");
  }
  return errors;
}

/**
 * Validate the configured command contract.
 *
 * @param {Record<string, unknown>} commands Commands section.
 * @returns {string[]} Validation errors.
 */
function validateCommandsSection(commands) {
  const errors = validateRequiredFields(commands, REQUIRED_COMMANDS, "commands");
  const required = commands.required;
  errors.push(...validateCommands(required, "commands.required"));
  errors.push(...validateCommands(commands.optional, "commands.optional", true));
  if (Array.isArray(required) && !required.includes("sh scripts/harness/validate_harness.sh")) {
    errors.push("commands.required must include sh scripts/harness/validate_harness.sh");
  }
  return errors;
}

/**
 * Validate CI and hook gate metadata.
 *
 * @param {Record<string, unknown>} gates Gates section.
 * @returns {string[]} Validation errors.
 */
function validateGatesSection(gates) {
  const errors = validateRequiredFields(gates, REQUIRED_GATES, "gates");
  if (!isObject(gates.ci)) {
    errors.push("gates.ci must be an object");
  } else {
    errors.push(...validateRequiredFields(gates.ci, REQUIRED_CI_GATE, "gates.ci"));
    if (!REQUIRED_CI_PROVIDERS.includes(gates.ci.provider)) {
      errors.push(`gates.ci.provider must be one of: ${REQUIRED_CI_PROVIDERS.join(", ")}`);
    }
    if (!Number.isInteger(gates.ci.stage) || gates.ci.stage < 0) {
      errors.push("gates.ci.stage must be a non-negative integer");
    }
    if (isObject(gates.ci.branches)) {
      for (const field of REQUIRED_BRANCH_SETS) {
        errors.push(...validateStringList(gates.ci.branches[field], `gates.ci.branches.${field}`));
      }
    } else if (gates.ci.branches !== undefined) {
      errors.push("gates.ci.branches must be an object");
    }
  }
  if (!isObject(gates.hooks)) {
    errors.push("gates.hooks must be an object");
  } else {
    errors.push(...validateRequiredFields(gates.hooks, REQUIRED_HOOKS_GATE, "gates.hooks"));
    if (typeof gates.hooks.enabled !== "boolean") {
      errors.push("gates.hooks.enabled must be a boolean");
    }
    if (!Number.isInteger(gates.hooks.stage) || gates.hooks.stage < 0) {
      errors.push("gates.hooks.stage must be a non-negative integer");
    }
  }
  return errors;
}

/**
 * Validate evidence ledger and generated-doc path roles.
 *
 * @param {Record<string, unknown>} evidence Evidence section.
 * @returns {string[]} Validation errors.
 */
function validateEvidenceSection(evidence) {
  const errors = validateRequiredFields(evidence, REQUIRED_EVIDENCE, "evidence");
  errors.push(...validatePathMapping(evidence, REQUIRED_EVIDENCE, "evidence"));
  return errors;
}

/**
 * Validate one optional implementation pack.
 *
 * @param {unknown} pack Pack config.
 * @param {string} packName Pack key.
 * @returns {string[]} Validation errors.
 */
function validatePack(pack, packName) {
  if (!PACK_NAME_PATTERN.test(packName)) {
    return [`packs.${packName} name must use lowercase letters, digits, or hyphens`];
  }
  if (!isObject(pack)) {
    return [`packs.${packName} must be an object`];
  }
  const errors = [];
  if (typeof pack.enabled !== "boolean") {
    errors.push(`packs.${packName}.enabled must be a boolean`);
  }
  errors.push(...validateCommands(pack.commands, `packs.${packName}.commands`, true));
  const pathErrors = validateStringList(pack.paths, `packs.${packName}.paths`, true);
  if (pathErrors.length > 0) {
    errors.push(...pathErrors);
  } else {
    for (const [index, pathValue] of pack.paths.entries()) {
      errors.push(...validateRepoRelativePath(pathValue, `packs.${packName}.paths[${index}]`));
    }
  }
  if (pack.enabled === true) {
    if (!Array.isArray(pack.commands) || pack.commands.length === 0) {
      errors.push(`packs.${packName}.commands must be non-empty when enabled`);
    }
    if (!Array.isArray(pack.paths) || pack.paths.length === 0) {
      errors.push(`packs.${packName}.paths must be non-empty when enabled`);
    }
  }
  return errors;
}

/**
 * Validate optional implementation packs.
 *
 * @param {Record<string, unknown>} packs Packs section.
 * @returns {string[]} Validation errors.
 */
function validatePacksSection(packs) {
  const errors = [];
  for (const [packName, pack] of Object.entries(packs)) {
    errors.push(...validatePack(pack, packName));
  }
  return errors;
}

/**
 * Validate explicit absence semantics for optional surfaces.
 *
 * @param {Record<string, unknown>} absence Absence section.
 * @param {Record<string, unknown>} gates Gates section.
 * @param {Record<string, unknown>} packs Packs section.
 * @returns {string[]} Validation errors.
 */
function validateAbsenceSection(absence, gates, packs) {
  const errors = validateRequiredFields(absence, REQUIRED_ABSENCE, "absence");
  for (const field of REQUIRED_ABSENCE) {
    if (field in absence && !ABSENCE_STATES.includes(absence[field])) {
      errors.push(`absence.${field} must be one of: ${ABSENCE_STATES.join(", ")}`);
    }
  }
  if (!REQUIRED_ALIAS_STATES.includes(absence.agentContextAlias)) {
    errors.push(`absence.agentContextAlias must be one of: ${REQUIRED_ALIAS_STATES.join(", ")}`);
  }
  if (isObject(gates.ci)) {
    if (gates.ci.provider === "none" && !INACTIVE_ABSENCE_STATES.includes(absence.ci)) {
      errors.push("absence.ci must mark CI absent when gates.ci.provider is none");
    }
    if (gates.ci.provider !== "none" && !ACTIVE_ABSENCE_STATES.includes(absence.ci)) {
      errors.push("absence.ci must be required or optional when CI provider is active");
    }
  }
  if (isObject(gates.hooks)) {
    if (gates.hooks.enabled === true && !ACTIVE_ABSENCE_STATES.includes(absence.hooks)) {
      errors.push("absence.hooks must be required or optional when hooks are enabled");
    }
    if (gates.hooks.enabled === false && !INACTIVE_ABSENCE_STATES.includes(absence.hooks)) {
      errors.push("absence.hooks must mark hooks absent when hooks are disabled");
    }
  }
  const enabledPacks = Object.values(packs).some((pack) => isObject(pack) && pack.enabled === true);
  if (enabledPacks && !ACTIVE_ABSENCE_STATES.includes(absence.packs)) {
    errors.push("absence.packs must be required or optional when any pack is enabled");
  }
  if (!enabledPacks && !INACTIVE_ABSENCE_STATES.includes(absence.packs)) {
    errors.push("absence.packs must mark packs absent when all packs are disabled");
  }
  return errors;
}

/**
 * Validate the versioned harness JSON shape with Bun only.
 *
 * @param {unknown} config Parsed harness config.
 * @returns {string[]} Validation errors.
 */
function validateConfig(config) {
  const errors = [];
  if (!isObject(config)) {
    return ["config root must be a JSON object"];
  }
  const root = config;
  for (const field of REQUIRED_TOP_LEVEL) {
    if (!(field in root)) {
      errors.push(`missing top-level field: ${field}`);
    }
  }
  for (const field of Object.keys(root)) {
    if (!REQUIRED_TOP_LEVEL.includes(field)) {
      errors.push(`unexpected top-level field: ${field}`);
    }
  }
  if (errors.length > 0) {
    return errors;
  }
  errors.push(...validateContractVersion(root));
  const profile = objectField(root, "profile", errors);
  const paths = objectField(root, "paths", errors);
  const docs = objectField(root, "docs", errors);
  const commands = objectField(root, "commands", errors);
  const gates = objectField(root, "gates", errors);
  const evidence = objectField(root, "evidence", errors);
  const packs = objectField(root, "packs", errors);
  const absence = objectField(root, "absence", errors);
  if (profile) {
    errors.push(...validateProfile(profile));
  }
  if (paths) {
    errors.push(...validatePathsSection(paths));
  }
  if (docs) {
    errors.push(...validateDocsSection(docs));
  }
  if (commands) {
    errors.push(...validateCommandsSection(commands));
  }
  if (gates) {
    errors.push(...validateGatesSection(gates));
  }
  if (evidence) {
    errors.push(...validateEvidenceSection(evidence));
  }
  if (packs) {
    errors.push(...validatePacksSection(packs));
  }
  if (absence && gates && packs) {
    errors.push(...validateAbsenceSection(absence, gates, packs));
  }
  return errors;
}

/**
 * Return whether an absolute path stays inside the repository root.
 *
 * @param {string} rootPath Absolute repository root path.
 * @param {string} candidatePath Absolute candidate path.
 * @returns {boolean} Whether candidatePath is under rootPath.
 */
function isInsideRoot(rootPath, candidatePath) {
  const relativePath = relative(rootPath, candidatePath);
  return relativePath === "" || (!relativePath.startsWith("..") && !isAbsolute(relativePath));
}

/**
 * Validate that a configured path resolves inside the repository and exists.
 *
 * @param {string} rootPath Absolute repository root path.
 * @param {unknown} pathValue Configured path value.
 * @param {string} fieldName Config field name for errors.
 * @param {string[]} errors Validation errors.
 */
function validateResolvedDeclaredPath(rootPath, pathValue, fieldName, errors) {
  if (typeof pathValue !== "string") {
    return;
  }
  if (!isRepoRelativePath(pathValue)) {
    errors.push(`${fieldName} must be repository-relative: ${pathValue}`);
    return;
  }
  const resolvedPath = resolve(rootPath, pathValue);
  if (!isInsideRoot(rootPath, resolvedPath)) {
    errors.push(`${fieldName} resolves outside repository root: ${pathValue}`);
  } else if (!existsSync(resolvedPath)) {
    errors.push(`${fieldName} is missing: ${pathValue}`);
  }
}

/**
 * Validate paths that are required for every installed harness.
 *
 * @param {Record<string, unknown>} config Parsed harness config.
 * @param {string} rootPath Absolute repository root path.
 * @param {string[]} errors Validation errors.
 */
function validateRequiredInstalledPaths(config, rootPath, errors) {
  const requiredFields = [
    "paths.harnessRoot",
    "paths.config",
    "paths.scriptsRoot",
    "paths.validator",
    "paths.wrapper",
    "docs.agentContext",
    "docs.architecture",
    "docs.guardrails",
    "docs.updates",
    "evidence.readiness",
    "evidence.knownViolations",
  ];
  for (const fieldName of requiredFields) {
    validateResolvedDeclaredPath(rootPath, dottedValue(config, fieldName), fieldName, errors);
  }
}

/**
 * Validate paths that become required when gates are active.
 *
 * @param {Record<string, unknown>} config Parsed harness config.
 * @param {string} rootPath Absolute repository root path.
 * @param {string[]} errors Validation errors.
 */
function validateGatePaths(config, rootPath, errors) {
  const gates = config.gates;
  const absence = config.absence;
  const paths = config.paths;
  const stage = currentStage(config);
  if (isObject(gates.ci) && ACTIVE_ABSENCE_STATES.includes(absence.ci) && Number.isInteger(gates.ci.stage) && stage >= gates.ci.stage) {
    if (gates.ci.provider === "github-actions") {
      validateResolvedDeclaredPath(rootPath, paths.githubWorkflow, "paths.githubWorkflow", errors);
    }
    if (gates.ci.provider === "gitlab-ci") {
      validateResolvedDeclaredPath(rootPath, paths.gitlabConfig, "paths.gitlabConfig", errors);
    }
  }
  if (isObject(gates.hooks) && ACTIVE_ABSENCE_STATES.includes(absence.hooks) && gates.hooks.enabled === true && Number.isInteger(gates.hooks.stage) && stage >= gates.hooks.stage) {
    for (const fieldName of ["hooksRoot", "commitMsgHook", "prePushHook"]) {
      validateResolvedDeclaredPath(rootPath, paths[fieldName], `paths.${fieldName}`, errors);
    }
  }
}

/**
 * Validate paths for enabled optional packs.
 *
 * @param {Record<string, unknown>} config Parsed harness config.
 * @param {string} rootPath Absolute repository root path.
 * @param {string[]} errors Validation errors.
 */
function validatePackPaths(config, rootPath, errors) {
  if (!ACTIVE_ABSENCE_STATES.includes(config.absence.packs)) {
    return;
  }
  for (const [packName, pack] of Object.entries(config.packs)) {
    if (!isObject(pack) || pack.enabled !== true || !Array.isArray(pack.paths)) {
      continue;
    }
    for (const [index, pathValue] of pack.paths.entries()) {
      validateResolvedDeclaredPath(rootPath, pathValue, `packs.${packName}.paths[${index}]`, errors);
    }
  }
}

/**
 * Validate declared paths that should exist after installation.
 *
 * @param {Record<string, unknown>} config Parsed harness config.
 * @param {string} rootPath Absolute repository root path.
 * @param {boolean} templateMode Whether path existence should be skipped.
 * @returns {string[]} Validation errors.
 */
function validatePaths(config, rootPath, templateMode) {
  if (templateMode) {
    return [];
  }
  const errors = [];
  validateRequiredInstalledPaths(config, rootPath, errors);
  validateGatePaths(config, rootPath, errors);
  validatePackPaths(config, rootPath, errors);
  return errors;
}

/**
 * Validate the agent-context symlink convention when present.
 *
 * @param {Record<string, unknown>} config Parsed harness config.
 * @param {string} rootPath Absolute repository root path.
 * @param {boolean} templateMode Whether symlink checks should be skipped.
 * @returns {string[]} Validation errors.
 */
function validateSymlinks(config, rootPath, templateMode) {
  if (templateMode || currentStage(config) < 1) {
    return [];
  }
  const errors = [];
  const aliasState = config.absence.agentContextAlias;
  if (!["pending-conflict", "not-applicable"].includes(aliasState)) {
    const compatibilitySymlink = config.paths.agentContextAlias;
    const compatibilityTarget = config.paths.agentContextAliasTarget;
    if (typeof compatibilitySymlink === "string" && typeof compatibilityTarget === "string") {
      const compatibilityPath = resolve(rootPath, compatibilitySymlink);
      if (aliasState === "required" && !existsSync(compatibilityPath)) {
        errors.push(`${compatibilitySymlink} must be present as a symlink`);
      } else if (existsSync(compatibilityPath)) {
        if (!lstatSync(compatibilityPath).isSymbolicLink()) {
          errors.push(`${compatibilitySymlink} exists but is not a symlink`);
        } else if (readlinkSync(compatibilityPath) !== compatibilityTarget) {
          errors.push(`${compatibilitySymlink} must point to ${compatibilityTarget}`);
        }
      }
    }
  }
  const skillsAliasPath = resolve(rootPath, SKILLS_ALIAS_PATH);
  const skillsAliasStatus = lstatSync(skillsAliasPath, { throwIfNoEntry: false });
  if (skillsAliasStatus?.isSymbolicLink()) {
    if (readlinkSync(skillsAliasPath) !== SKILLS_ALIAS_TARGET) {
      errors.push(`${SKILLS_ALIAS_PATH} must point to ${SKILLS_ALIAS_TARGET}`);
    }
  } else if (skillsAliasStatus) {
    errors.push(`${SKILLS_ALIAS_PATH} exists but is not a symlink`);
  }
  return errors;
}

/**
 * Run Bun-native harness validation.
 *
 * @param {string[]} args Command-line arguments after the Bun script path.
 * @returns {number} Process exit code.
 */
function main(args) {
  const options = parseArgs(args);
  const rootPath = resolve(options.rootPath);
  const configPath = resolve(rootPath, options.configPath);
  if (!existsSync(configPath)) {
    console.error(`harness validation failed: config file is missing: ${configPath}`);
    return 1;
  }
  const config = JSON.parse(readFileSync(configPath, "utf8"));
  const errors = validateConfig(config);
  if (errors.length === 0) {
    errors.push(...validatePaths(config, rootPath, options.templateMode));
    errors.push(...validateSymlinks(config, rootPath, options.templateMode));
  }
  for (const error of errors) {
    console.error(`harness validation failed: ${error}`);
  }
  if (errors.length > 0) {
    return 1;
  }
  console.log("harness validation passed");
  return 0;
}

try {
  process.exitCode = main(process.argv.slice(2));
} catch (error) {
  console.error(`harness validation failed: ${error.message}`);
  process.exitCode = 1;
}
