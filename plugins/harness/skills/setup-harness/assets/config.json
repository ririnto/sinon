{
  "contractVersion": 1,
  "profile": {
    "name": "default",
    "stage": 1,
    "targetStage": 3,
    "level": "warn"
  },
  "paths": {
    "harnessRoot": "docs/harness",
    "config": "docs/harness/config.json",
    "scriptsRoot": "scripts/harness",
    "validator": "scripts/harness/validate_harness.py",
    "wrapper": "scripts/harness/validate_harness.sh",
    "agentsRoot": ".claude/agents",
    "agentContextAlias": "AGENTS.md",
    "agentContextAliasTarget": "CLAUDE.md",
    "githubWorkflow": ".github/workflows/harness-checks.yml",
    "gitlabConfig": ".gitlab-ci.yml",
    "hooksRoot": ".git/hooks",
    "preCommitHook": ".git/hooks/pre-commit",
    "hookInstaller": "scripts/harness/setup-hooks.sh"
  },
  "docs": {
    "agentContext": "CLAUDE.md",
    "architecture": "ARCHITECTURE.md",
    "guardrails": "docs/harness/guardrails.md",
    "readiness": "docs/harness/readiness.md",
    "updates": "docs/harness/updates.md"
  },
  "commands": {
    "required": [
      "sh scripts/harness/validate_harness.sh"
    ],
    "optional": []
  },
  "gates": {
    "ci": {
      "provider": "github-actions",
      "stage": 3,
      "branches": {
        "push": [
          "develop",
          "main",
          "master"
        ],
        "pullRequest": [
          "develop",
          "main",
          "master"
        ],
        "mergeRequest": [
          "develop",
          "main",
          "master"
        ]
      }
    },
    "hooks": {
      "enabled": false,
      "stage": 2
    }
  },
  "evidence": {
    "readiness": "docs/harness/readiness.md",
    "knownViolations": "docs/harness/known-violations.md",
    "generatedDocs": "docs/generated"
  },
  "packs": {
    "bun": {
      "enabled": false,
      "commands": [
        "bun scripts/harness/validate-harness.mjs"
      ],
      "paths": [
        "scripts/harness/validate-harness.mjs"
      ]
    },
    "gradle": {
      "enabled": false,
      "commands": [
        "./gradlew harnessCheck"
      ],
      "paths": [
        "build.gradle.kts"
      ]
    },
    "maven": {
      "enabled": false,
      "commands": [
        "mvn local.harness:harness-maven-plugin:harness-check"
      ],
      "paths": [
        "pom.xml"
      ]
    }
  },
  "absence": {
    "agentContextAlias": "required",
    "targetAgents": "disabled",
    "ci": "required",
    "hooks": "disabled",
    "packs": "disabled"
  }
}
