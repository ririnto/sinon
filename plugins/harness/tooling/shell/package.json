{
  "scripts": {
    "check": "run-p check:*",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "pre-commit": "sh .husky/pre-commit",
    "pre-push": "sh .husky/pre-push",
    "prepare": "husky",
    "shell:check": "run-s shell:lint shell:format",
    "shell:format": "git ls-files -z -- '*.sh' | xargs -0 -r shfmt -d --",
    "shell:lint": "git ls-files -z -- '*.sh' | xargs -0 -r shellcheck -S warning --"
  },
  "devDependencies": {
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:"
  }
}
