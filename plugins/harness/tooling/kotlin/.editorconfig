root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
continuation_indent_size = 4
ij_continuation_indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,jsonc}]
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2

[*.{yaml,yml}]
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2

[*.{md,markdown}]
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2
max_line_length = unset

[*.{kt,kts}]
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false
ij_kotlin_code_style_defaults = KOTLIN_STYLE_GUIDE
ij_kotlin_name_count_to_use_star_import = 1
ij_kotlin_name_count_to_use_star_import_for_members = 1
ktlint_code_style = ktlint_official
ktlint_standard_function-expression-body = enabled
ktlint_standard_if-else-bracing = enabled
ktlint_standard_multiline-if-else = enabled
ktlint_standard_no-consecutive-blank-lines = enabled
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_trailing-comma-on-call-site = enabled
ktlint_standard_trailing-comma-on-declaration-site = enabled

[{*.sh,*.bash,*.zsh}]
indent_style = space
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2
