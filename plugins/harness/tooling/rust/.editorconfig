root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
continuation_indent_size = 4
ij_continuation_indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,jsonc}]
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2

[*.{yaml,yml}]
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2

[*.{md,markdown}]
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2
max_line_length = unset

[*.rs]
max_line_length = 100

[*.toml]
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2

[{*.sh,*.bash,*.zsh}]
indent_style = space
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2
