{
  "scripts": {
    "check": "run-p check:*",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "pre-commit": "run-s check rust:format rust:lint",
    "pre-push": "run-s check rust:check",
    "prepare": "husky",
    "rust:check": "run-s rust:format rust:lint rust:test",
    "rust:format": "cargo fmt --all -- --check",
    "rust:lint": "cargo clippy --workspace --all-targets --all-features -- -D clippy::cognitive_complexity -D warnings",
    "rust:test": "cargo test --workspace"
  },
  "devDependencies": {
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:"
  }
}
