spotless {
    java {
        palantirJavaFormat(libs.versions.palantirJavaFormat.get())
            .style("PALANTIR")
            .formatJavadoc(true)
        removeUnusedImports()
        trimTrailingWhitespace()
        endWithNewline()
    }
}

checkstyle {
    toolVersion = libs.versions.checkstyle.get()
    configFile = file("tooling/java/checkstyle.xml")
}
