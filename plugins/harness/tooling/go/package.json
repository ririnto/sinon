{
  "scripts": {
    "check": "run-p check:*",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "go:check": "run-s go:lint go:format go:nilaway go:test",
    "go:format": "golangci-lint fmt --diff",
    "go:lint": "golangci-lint run",
    "go:nilaway": "nilaway -include-pkgs=\"$(go list -m)\" ./...",
    "go:test": "go test -race -shuffle=on -count=1 ./...",
    "pre-commit": "run-s check go:lint go:format go:nilaway",
    "pre-push": "run-s check go:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:"
  }
}
