{
  "scripts": {
    "check": "run-p check:*",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "go:check": "run-s go:lint go:format go:nilaway go:test",
    "go:docs": "pkgsite -list=false",
    "go:format": "sh scripts/go-check.sh format",
    "go:lint": "sh scripts/go-check.sh lint",
    "go:nilaway": "sh scripts/go-check.sh nilaway",
    "go:test": "sh scripts/go-check.sh test",
    "pre-commit": "run-s check go:lint go:format go:nilaway",
    "pre-push": "run-s check go:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "npm-run-all2": "catalog:"
  }
}
