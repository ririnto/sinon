{
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-s check:markdownlint-cli2 check:uv check:test",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:test": "run-p check:test:*",
    "check:test:uv": "uv run --package workspace-greeter python -m unittest discover -s apps/greeter/tests",
    "check:uv": "run-p check:uv:*",
    "check:uv:format": "uv run ruff format --check .",
    "check:uv:lint": "uv run ruff check .",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky",
    "uv:doc": "uv run --all-packages --group docs sphinx-build -n -W -b html docs build/api-docs"
  },
  "devDependencies": {
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "npm-run-all2": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
