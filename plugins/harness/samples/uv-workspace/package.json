{
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "pre-commit": "run-s check uv:check",
    "pre-push": "run-s check uv:check uv:test",
    "prepare": "husky",
    "uv:check": "run-s uv:lint uv:format",
    "uv:format": "uv run ruff format --check .",
    "uv:lint": "uv run ruff check .",
    "uv:test": "uv run --package workspace-greeter python -m unittest discover -s apps/greeter/tests",
    "uv:doc": "uv run --all-packages --group docs sphinx-build -n -W -b html docs build/api-docs"
  },
  "devDependencies": {
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "npm-run-all2": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
