{
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-s check:markdownlint-cli2 check:rust check:test",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:rust": "run-p check:rust:*",
    "check:rust:format": "cargo fmt --all -- --check",
    "check:rust:lint": "cargo clippy --workspace --all-targets --all-features -- -D clippy::cognitive_complexity -D warnings",
    "check:test": "run-p check:test:*",
    "check:test:rust": "cargo test --workspace",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky",
    "rust:doc": "RUSTDOCFLAGS=\"${RUSTDOCFLAGS:+$RUSTDOCFLAGS }-D warnings\" cargo doc --workspace --no-deps"
  },
  "devDependencies": {
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "npm-run-all2": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
