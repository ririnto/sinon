{
  "name": "invoice-workspace-sample",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:ultracite": "run-p --continue-on-error ultracite:check:**",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "run-s --continue-on-error ultracite:fix:base ultracite:check:style:*",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky",
    "ultracite:check:base": "ultracite check --type-aware",
    "ultracite:check:style:no-blank-lines-in-functions": "ultracite check --type-aware --config oxlint.style-no-blank-lines-in-functions.config.ts",
    "ultracite:check:style:no-inline-comments-in-functions": "ultracite check --type-aware --config oxlint.style-no-inline-comments-in-functions.config.ts",
    "ultracite:check:style:sibling-test-spacing": "ultracite check --type-aware --config oxlint.style-sibling-test-spacing.config.ts",
    "ultracite:fix:base": "ultracite fix --type-aware",
    "build": "pnpm --filter @sample/invoice run build",
    "check:sample": "run-s test",
    "test": "run-s build test:packages",
    "test:packages": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "@oxc-project/types": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
