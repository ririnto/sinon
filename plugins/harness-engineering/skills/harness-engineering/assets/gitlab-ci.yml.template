stages:
  - check

workflow:
  rules:
    - if: "$CI_PIPELINE_SOURCE == \"merge_request_event\""
    - if: "$CI_PIPELINE_SOURCE == \"push\" && $CI_COMMIT_BRANCH =~
        /^(develop|main|master)$/"
    - when: never

harness:
  stage: check
  rules:
    - if: "$CI_PIPELINE_SOURCE == \"merge_request_event\""
    - if: "$CI_PIPELINE_SOURCE == \"push\" && $CI_COMMIT_BRANCH =~
        /^(develop|main|master)$/"
  before_script:
    - >-
      python3 --version || python --version || uvx --offline
      --no-python-downloads python --version
  script:
    - sh scripts/harness/validate_harness.sh
