import org.gradle.api.DefaultTask
import org.gradle.api.GradleException
import org.gradle.api.file.RegularFileProperty
import org.gradle.api.tasks.InputFile
import org.gradle.api.tasks.TaskAction
import java.io.File
import kotlinx.serialization.json.Json
import kotlinx.serialization.json.JsonArray
import kotlinx.serialization.json.JsonElement
import kotlinx.serialization.json.JsonObject
import kotlinx.serialization.json.JsonPrimitive
import kotlinx.serialization.json.booleanOrNull
import kotlinx.serialization.json.intOrNull
import kotlinx.serialization.json.jsonObject
import kotlinx.serialization.json.jsonPrimitive

/** Validates the harness-engineering config shape with Gradle-native JSON parsing. */
abstract class HarnessCheckTask : DefaultTask() {
    /** Harness config file to validate. */
    @get:InputFile
    abstract val configFile: RegularFileProperty

    /** Execute Gradle-native harness validation. */
    @TaskAction
    fun validateHarness() {
        val file = configFile.get().asFile
        val errors = validateConfig(file)
        if (errors.isNotEmpty()) {
            errors.forEach { logger.error("harness validation failed: $it") }
            throw GradleException("harness validation failed")
        }
        logger.lifecycle("harness validation passed")
    }

    /** Validate the six-field harness config structure and repository-relative paths. */
    private fun validateConfig(file: File): List<String> {
        if (!file.isFile) {
            return listOf("config file is missing: ${file.path}")
        }
        val errors = mutableListOf<String>()
        val parsedRoot = Json.parseToJsonElement(file.readText())
        if (parsedRoot !is JsonObject) {
            return listOf("config root must be a JSON object")
        }
        val root = parsedRoot.jsonObject
        val requiredTopLevel = setOf("stage", "docs", "scripts", "checks", "ci", "hooks")
        requiredTopLevel.forEach { field ->
            if (!root.containsKey(field)) {
                errors.add("missing top-level field: $field")
            }
        }
        root.keys.filterNot(requiredTopLevel::contains).forEach { field ->
            errors.add("unexpected top-level field: $field")
        }
        val stage = root.objectField("stage", errors)
        if (stage != null) {
            listOf("current", "target", "mode", "exitGate").forEach { field ->
                if (!stage.containsKey(field)) {
                    errors.add("missing stage field: $field")
                }
            }
            if ((stage["current"] as? JsonPrimitive)?.intOrNull == null) {
                errors.add("stage.current must be an integer")
            }
            if ((stage["target"] as? JsonPrimitive)?.intOrNull == null) {
                errors.add("stage.target must be an integer")
            }
            if (stage.stringField("mode").isNullOrEmpty()) {
                errors.add("stage.mode must be a non-empty string")
            }
            if (stage.stringField("exitGate").isNullOrEmpty()) {
                errors.add("stage.exitGate must be a non-empty string")
            }
        }
        val docs = root.objectField("docs", errors)
        if (docs != null) {
            listOf("harnessRoot", "config", "convention", "entrypoint", "compatibilitySymlink", "compatibilitySymlinkTarget", "compatibilitySymlinkStatus", "architecture", "guardrails", "knownViolations", "readiness", "updates").forEach { field ->
                if (!docs.containsKey(field)) {
                    errors.add("missing docs field: $field")
                }
            }
            if (docs.stringField("config") != "docs/harness-engineering/harness-engineering.json") {
                errors.add("docs.config must be docs/harness-engineering/harness-engineering.json")
            }
            if (docs.stringField("harnessRoot") != "docs/harness-engineering") {
                errors.add("docs.harnessRoot must be docs/harness-engineering")
            }
            if (docs.stringField("convention").isNullOrEmpty()) {
                errors.add("docs.convention must be a non-empty string")
            }
            if (docs.stringField("entrypoint") != "CLAUDE.md") {
                errors.add("docs.entrypoint must be CLAUDE.md")
            }
            if (docs.stringField("compatibilitySymlink") != "AGENTS.md" || docs.stringField("compatibilitySymlinkTarget") != "CLAUDE.md") {
                errors.add("docs compatibility symlink must be AGENTS.md -> CLAUDE.md")
            }
            if (docs.stringField("compatibilitySymlinkStatus") !in setOf("required", "pending-conflict", "not-applicable")) {
                errors.add("docs.compatibilitySymlinkStatus must be one of: required, pending-conflict, not-applicable")
            }
            listOf("harnessRoot", "config", "entrypoint", "compatibilitySymlink", "compatibilitySymlinkTarget", "architecture", "guardrails", "knownViolations", "readiness", "updates").forEach { field ->
                validateRepoRelativePath(docs.stringField(field), "docs.$field", errors)
            }
        }
        val scripts = root.objectField("scripts", errors)
        if (scripts != null) {
            listOf("root", "validator", "wrapper").forEach { field ->
                if (!scripts.containsKey(field)) {
                    errors.add("missing scripts field: $field")
                }
                validateRepoRelativePath(scripts.stringField(field), "scripts.$field", errors)
            }
        }
        val checks = root.objectField("checks", errors)
        if (checks != null) {
            validateCommandList(checks["requiredCommands"], "checks.requiredCommands", errors)
            validateCommandList(checks["optionalCommands"], "checks.optionalCommands", errors)
            validateCommandList(checks["allowedCommandPrefixes"], "checks.allowedCommandPrefixes", errors)
        }
        val ci = root.objectField("ci", errors)
        if (ci != null) {
            val provider = ci.stringField("provider")
            if (provider !in setOf("github-actions", "gitlab-ci", "none")) {
                errors.add("ci.provider must be one of: github-actions, gitlab-ci, none")
            }
            validateRepoRelativePath(ci.stringField("githubWorkflow"), "ci.githubWorkflow", errors)
            validateRepoRelativePath(ci.stringField("gitlabConfig"), "ci.gitlabConfig", errors)
            val branches = ci["branches"] as? JsonObject
            if (branches != null) {
                listOf("push", "pullRequest", "mergeRequest").forEach { field ->
                    validateStringList(branches[field], "ci.branches.$field", errors)
                }
            } else if (ci.containsKey("branches")) {
                errors.add("ci.branches must be an object")
            }
        }
        val hooks = root.objectField("hooks", errors)
        if (hooks != null) {
            listOf("enabled", "path", "commitMsg", "prePush").forEach { field ->
                if (!hooks.containsKey(field)) {
                    errors.add("missing hooks field: $field")
                }
            }
            if ((hooks["enabled"] as? JsonPrimitive)?.booleanOrNull == null) {
                errors.add("hooks.enabled must be a boolean")
            }
            listOf("path", "commitMsg", "prePush").forEach { field ->
                validateRepoRelativePath(hooks.stringField(field), "hooks.$field", errors)
            }
        }
        return errors
    }

    /** Return a required object field or append a structural validation error. */
    private fun JsonObject.objectField(field: String, errors: MutableList<String>): JsonObject? {
        val value = this[field]
        if (value !is JsonObject) {
            errors.add("$field must be an object")
            return null
        }
        return value
    }

    /** Return a string field value from a JSON object. */
    private fun JsonObject.stringField(field: String): String? {
        val value: JsonElement = this[field] ?: return null
        val primitive = value as? JsonPrimitive ?: return null
        return primitive.content
    }

    /** Validate one repository-relative path field. */
    private fun validateRepoRelativePath(value: String?, field: String, errors: MutableList<String>) {
        if (value == null) {
            return
        }
        if (value.contains('\\') || Regex("^[A-Za-z]:").containsMatchIn(value) || value.startsWith("/") || value.startsWith("//") || value.split('/').contains("..")) {
            errors.add("$field must be a repository-relative path without '..'")
        }
    }

    /** Validate a non-empty string list. */
    private fun validateStringList(value: JsonElement?, field: String, errors: MutableList<String>) {
        val items = value as? JsonArray
        if (items == null || items.isEmpty() || items.any { it !is JsonPrimitive || !it.isString || it.content.isEmpty() }) {
            errors.add("$field must be a non-empty list of strings")
        }
    }

    /** Validate trusted command strings without executing them. */
    private fun validateCommandList(value: JsonElement?, field: String, errors: MutableList<String>) {
        if (value == null && field != "checks.requiredCommands") {
            return
        }
        val commands = value as? JsonArray
        if (commands == null || commands.any { it !is JsonPrimitive || !it.isString }) {
            errors.add("$field must be a list of commands")
            return
        }
        val trustedCommands = setOf(
            "sh scripts/harness/validate_harness.sh",
            "node scripts/harness/validate-harness.mjs",
            "./gradlew harnessCheck",
            "mvn local.harness:harness-maven-plugin:harness-check",
        )
        val unsafeCommandChars = setOf(';', '|', '&', '`', '$', '>', '<', '\n')
        commands.map { it.jsonPrimitive.content }.forEachIndexed { index, command ->
            if (command.any(unsafeCommandChars::contains)) {
                errors.add("$field[$index] contains shell metacharacters: $command")
            } else if (command !in trustedCommands) {
                errors.add("$field[$index] command is not an allowed argv form: $command")
            }
        }
    }
}
