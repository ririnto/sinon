#!/usr/bin/env node
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";

const DEFAULT_CONFIG_PATH = "docs/harness-engineering/harness-engineering.json";
const REQUIRED_TOP_LEVEL = ["stage", "docs", "scripts", "checks", "ci", "hooks"];
const REQUIRED_STAGE = ["current", "target", "mode", "exitGate"];
const REQUIRED_DOCS = [
  "harnessRoot",
  "config",
  "convention",
  "entrypoint",
  "compatibilitySymlink",
  "compatibilitySymlinkTarget",
  "compatibilitySymlinkStatus",
  "architecture",
  "guardrails",
  "knownViolations",
  "readiness",
  "updates",
];
const REQUIRED_SCRIPTS = ["root", "validator", "wrapper"];
const REQUIRED_HOOKS = ["enabled", "path", "commitMsg", "prePush"];
const REQUIRED_CI_PROVIDERS = ["github-actions", "gitlab-ci", "none"];
const REQUIRED_SYMLINK_STATUSES = ["required", "pending-conflict", "not-applicable"];
const TRUSTED_COMMAND_FORMS = [
  "sh scripts/harness/validate_harness.sh",
  "node scripts/harness/validate-harness.mjs",
  "./gradlew harnessCheck",
  "mvn local.harness:harness-maven-plugin:harness-check",
];
const UNSAFE_COMMAND_PATTERN = /[;|&`$><\n]/u;

/**
 * Parse command-line arguments for Node-native harness validation.
 *
 * @param {string[]} args Command-line arguments after the node script path.
 * @returns {{ configPath: string, rootPath: string }} Parsed validation options.
 */
function parseArgs(args) {
  const options = {
    configPath: process.env.HARNESS_CONFIG ?? DEFAULT_CONFIG_PATH,
    rootPath: process.env.HARNESS_ROOT ?? ".",
  };
  for (let index = 0; index < args.length; index += 1) {
    if (args[index] === "--config" && index + 1 < args.length) {
      options.configPath = args[index + 1];
      index += 1;
    } else if (args[index] === "--root" && index + 1 < args.length) {
      options.rootPath = args[index + 1];
      index += 1;
    } else if (args[index] === "--template") {
      continue;
    } else {
      throw new Error(`unsupported argument: ${args[index]}`);
    }
  }
  return options;
}

/**
 * Return whether a config path is repository-relative and does not escape root.
 *
 * @param {unknown} value Config value to inspect.
 * @returns {boolean} Whether the value is a safe repository-relative path.
 */
function isRepoRelativePath(value) {
  return (
    typeof value === "string" &&
    value.length > 0 &&
    !value.includes("\\") &&
    !/^[A-Za-z]:/u.test(value) &&
    !value.startsWith("/") &&
    !value.startsWith("//") &&
    !value.split("/").includes("..")
  );
}

/**
 * Return whether a value is a plain JSON object.
 *
 * @param {unknown} value Value to inspect.
 * @returns {boolean} Whether the value is a JSON object.
 */
function isObject(value) {
  return Boolean(value) && typeof value === "object" && !Array.isArray(value);
}

/**
 * Validate a JSON object value.
 *
 * @param {Record<string, unknown>} root Parent object.
 * @param {string} field Field name.
 * @param {string[]} errors Validation errors.
 * @returns {Record<string, unknown> | undefined} Object value when valid.
 */
function objectField(root, field, errors) {
  if (!isObject(root[field])) {
    errors.push(`${field} must be an object`);
    return undefined;
  }
  return root[field];
}

/**
 * Validate one string list field.
 *
 * @param {unknown} value Config value.
 * @param {string} fieldName Config field name.
 * @returns {string[]} Validation errors.
 */
function validateStringList(value, fieldName) {
  if (!Array.isArray(value) || value.length === 0 || !value.every((item) => typeof item === "string" && item.length > 0)) {
    return [`${fieldName} must be a non-empty list of strings`];
  }
  return [];
}

/**
 * Validate trusted command strings without executing them.
 *
 * @param {unknown} commands Configured command list.
 * @param {string} fieldName Config field name for errors.
 * @returns {string[]} Validation errors.
 */
function validateCommands(commands, fieldName) {
  if (!Array.isArray(commands) || !commands.every((command) => typeof command === "string")) {
    return [`${fieldName} must be a list of commands`];
  }
  const errors = [];
  for (const [index, command] of commands.entries()) {
    if (UNSAFE_COMMAND_PATTERN.test(command)) {
      errors.push(`${fieldName}[${index}] contains shell metacharacters: ${command}`);
    } else if (!TRUSTED_COMMAND_FORMS.includes(command)) {
      errors.push(`${fieldName}[${index}] command is not an allowed argv form: ${command}`);
    }
  }
  return errors;
}

/**
 * Validate the harness-engineering JSON shape with Node.js only.
 *
 * @param {unknown} config Parsed harness config.
 * @returns {string[]} Validation errors.
 */
function validateConfig(config) {
  const errors = [];
  if (!isObject(config)) {
    return ["config root must be a JSON object"];
  }
  const root = config;
  for (const field of REQUIRED_TOP_LEVEL) {
    if (!(field in root)) {
      errors.push(`missing top-level field: ${field}`);
    }
  }
  for (const field of Object.keys(root)) {
    if (!REQUIRED_TOP_LEVEL.includes(field)) {
      errors.push(`unexpected top-level field: ${field}`);
    }
  }
  const stage = objectField(root, "stage", errors);
  const docs = objectField(root, "docs", errors);
  const scripts = objectField(root, "scripts", errors);
  const checks = objectField(root, "checks", errors);
  const ci = objectField(root, "ci", errors);
  const hooks = objectField(root, "hooks", errors);

  if (stage) {
    for (const field of REQUIRED_STAGE) {
      if (!(field in stage)) {
        errors.push(`missing stage field: ${field}`);
      }
    }
    if (!Number.isInteger(stage.current)) {
      errors.push("stage.current must be an integer");
    }
    if (!Number.isInteger(stage.target)) {
      errors.push("stage.target must be an integer");
    }
    if (typeof stage.mode !== "string" || stage.mode.length === 0) {
      errors.push("stage.mode must be a non-empty string");
    }
    if (typeof stage.exitGate !== "string" || stage.exitGate.length === 0) {
      errors.push("stage.exitGate must be a non-empty string");
    }
  }

  if (docs) {
    for (const field of REQUIRED_DOCS) {
      if (!(field in docs)) {
        errors.push(`missing docs field: ${field}`);
      }
    }
    if (docs.config !== DEFAULT_CONFIG_PATH) {
      errors.push(`docs.config must be ${DEFAULT_CONFIG_PATH}`);
    }
    if (docs.harnessRoot !== "docs/harness-engineering") {
      errors.push("docs.harnessRoot must be docs/harness-engineering");
    }
    if (typeof docs.convention !== "string" || docs.convention.length === 0) {
      errors.push("docs.convention must be a non-empty string");
    }
    if (docs.entrypoint !== "CLAUDE.md") {
      errors.push("docs.entrypoint must be CLAUDE.md");
    }
    if (docs.compatibilitySymlink !== "AGENTS.md" || docs.compatibilitySymlinkTarget !== "CLAUDE.md") {
      errors.push("docs compatibility symlink must be AGENTS.md -> CLAUDE.md");
    }
    if (!REQUIRED_SYMLINK_STATUSES.includes(docs.compatibilitySymlinkStatus)) {
      errors.push(`docs.compatibilitySymlinkStatus must be one of: ${REQUIRED_SYMLINK_STATUSES.join(", ")}`);
    }
    for (const field of ["harnessRoot", "config", "entrypoint", "compatibilitySymlink", "compatibilitySymlinkTarget", "architecture", "guardrails", "knownViolations", "readiness", "updates"]) {
      if (field in docs && !isRepoRelativePath(docs[field])) {
        errors.push(`docs.${field} must be a repository-relative path without '..'`);
      }
    }
  }

  if (scripts) {
    for (const field of REQUIRED_SCRIPTS) {
      if (!(field in scripts)) {
        errors.push(`missing scripts field: ${field}`);
      }
      if (!isRepoRelativePath(scripts[field])) {
        errors.push(`scripts.${field} must be a repository-relative path without '..'`);
      }
    }
  }

  if (checks) {
    errors.push(...validateCommands(checks.requiredCommands, "checks.requiredCommands"));
    if ("optionalCommands" in checks) {
      errors.push(...validateCommands(checks.optionalCommands, "checks.optionalCommands"));
    }
    if ("allowedCommandPrefixes" in checks) {
      errors.push(...validateCommands(checks.allowedCommandPrefixes, "checks.allowedCommandPrefixes"));
    }
  }

  if (ci) {
    if (!REQUIRED_CI_PROVIDERS.includes(ci.provider)) {
      errors.push(`ci.provider must be one of: ${REQUIRED_CI_PROVIDERS.join(", ")}`);
    }
    for (const field of ["githubWorkflow", "gitlabConfig"]) {
      if (field in ci && !isRepoRelativePath(ci[field])) {
        errors.push(`ci.${field} must be a repository-relative path without '..'`);
      }
    }
    if ("branches" in ci) {
      if (!isObject(ci.branches)) {
        errors.push("ci.branches must be an object");
      } else {
        for (const field of ["push", "pullRequest", "mergeRequest"]) {
          errors.push(...validateStringList(ci.branches[field], `ci.branches.${field}`));
        }
      }
    }
  }

  if (hooks) {
    for (const field of REQUIRED_HOOKS) {
      if (!(field in hooks)) {
        errors.push(`missing hooks field: ${field}`);
      }
    }
    if (typeof hooks.enabled !== "boolean") {
      errors.push("hooks.enabled must be a boolean");
    }
    for (const field of ["path", "commitMsg", "prePush"]) {
      if (field in hooks && !isRepoRelativePath(hooks[field])) {
        errors.push(`hooks.${field} must be a repository-relative path without '..'`);
      }
    }
  }
  return errors;
}

/**
 * Run Node-native harness validation.
 *
 * @param {string[]} args Command-line arguments after the node script path.
 * @returns {number} Process exit code.
 */
function main(args) {
  const options = parseArgs(args);
  const configPath = resolve(options.rootPath, options.configPath);
  if (!existsSync(configPath)) {
    console.error(`harness validation failed: config file is missing: ${configPath}`);
    return 1;
  }
  const config = JSON.parse(readFileSync(configPath, "utf8"));
  const errors = validateConfig(config);
  for (const error of errors) {
    console.error(`harness validation failed: ${error}`);
  }
  if (errors.length > 0) {
    return 1;
  }
  console.log("harness validation passed");
  return 0;
}

try {
  process.exitCode = main(process.argv.slice(2));
} catch (error) {
  console.error(`harness validation failed: ${error.message}`);
  process.exitCode = 1;
}
