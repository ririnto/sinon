package com.example.harness;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import org.apache.maven.plugin.AbstractMojo;
import org.apache.maven.plugin.MojoExecutionException;
import org.apache.maven.plugins.annotations.Mojo;
import org.apache.maven.plugins.annotations.Parameter;

/** Runs Maven-native harness-engineering validation as a Maven goal. */
@Mojo(name = "harness-check")
public final class HarnessCheckMojo extends AbstractMojo {
    /** Harness configuration path relative to the project base directory. */
    @Parameter(defaultValue = "docs/harness-engineering/harness-engineering.json")
    private String configPath;

    /** Maven project base directory. */
    @Parameter(defaultValue = "${project.basedir}", readonly = true, required = true)
    private java.io.File basedir;

    /** JSON parser used for structural validation. */
    private final ObjectMapper objectMapper = new ObjectMapper();

    /** Executes Maven-native harness validation. */
    @Override
    public void execute() throws MojoExecutionException {
        try {
            Path config = basedir.toPath().resolve(configPath).normalize();
            ArrayList<String> errors = validateConfig(config);
            for (String error : errors) {
                getLog().error("harness validation failed: " + error);
            }
            if (!errors.isEmpty()) {
                throw new MojoExecutionException("harness validation failed");
            }
            getLog().info("harness validation passed");
        } catch (IOException error) {
            throw new MojoExecutionException("failed to read harness config", error);
        }
    }

    /** Validates the six-field harness config structure and repository-relative paths. */
    private ArrayList<String> validateConfig(Path config) throws IOException {
        ArrayList<String> errors = new ArrayList<>();
        if (!Files.isRegularFile(config)) {
            errors.add("config file is missing: " + config);
            return errors;
        }
        JsonNode root = objectMapper.readTree(Files.readString(config));
        if (!root.isObject()) {
            errors.add("config root must be a JSON object");
            return errors;
        }
        java.util.List<String> topLevel = java.util.List.of("stage", "docs", "scripts", "checks", "ci", "hooks");
        for (String field : topLevel) {
            if (!root.has(field)) {
                errors.add("missing top-level field: " + field);
            }
        }
        root.fieldNames().forEachRemaining(field -> {
            if (!topLevel.contains(field)) {
                errors.add("unexpected top-level field: " + field);
            }
        });
        JsonNode stage = objectField(root, "stage", errors);
        if (stage != null) {
            for (String field : java.util.List.of("current", "target", "mode", "exitGate")) {
                if (!stage.has(field)) {
                    errors.add("missing stage field: " + field);
                }
            }
            if (!stage.path("current").isInt()) {
                errors.add("stage.current must be an integer");
            }
            if (!stage.path("target").isInt()) {
                errors.add("stage.target must be an integer");
            }
            if (stringField(stage, "mode") == null || stringField(stage, "mode").isEmpty()) {
                errors.add("stage.mode must be a non-empty string");
            }
            if (stringField(stage, "exitGate") == null || stringField(stage, "exitGate").isEmpty()) {
                errors.add("stage.exitGate must be a non-empty string");
            }
        }
        JsonNode docs = objectField(root, "docs", errors);
        if (docs != null) {
            for (String field : java.util.List.of("harnessRoot", "config", "convention", "entrypoint", "compatibilitySymlink", "compatibilitySymlinkTarget", "compatibilitySymlinkStatus", "architecture", "guardrails", "knownViolations", "readiness", "updates")) {
                if (!docs.has(field)) {
                    errors.add("missing docs field: " + field);
                }
            }
            if (!"docs/harness-engineering/harness-engineering.json".equals(stringField(docs, "config"))) {
                errors.add("docs.config must be docs/harness-engineering/harness-engineering.json");
            }
            if (!"docs/harness-engineering".equals(stringField(docs, "harnessRoot"))) {
                errors.add("docs.harnessRoot must be docs/harness-engineering");
            }
            if (stringField(docs, "convention") == null || stringField(docs, "convention").isEmpty()) {
                errors.add("docs.convention must be a non-empty string");
            }
            if (!"CLAUDE.md".equals(stringField(docs, "entrypoint"))) {
                errors.add("docs.entrypoint must be CLAUDE.md");
            }
            if (!"AGENTS.md".equals(stringField(docs, "compatibilitySymlink")) || !"CLAUDE.md".equals(stringField(docs, "compatibilitySymlinkTarget"))) {
                errors.add("docs compatibility symlink must be AGENTS.md -> CLAUDE.md");
            }
            if (!java.util.List.of("required", "pending-conflict", "not-applicable").contains(stringField(docs, "compatibilitySymlinkStatus"))) {
                errors.add("docs.compatibilitySymlinkStatus must be one of: required, pending-conflict, not-applicable");
            }
            for (String field : java.util.List.of("harnessRoot", "config", "entrypoint", "compatibilitySymlink", "compatibilitySymlinkTarget", "architecture", "guardrails", "knownViolations", "readiness", "updates")) {
                validateRepoRelativePath(stringField(docs, field), "docs." + field, errors);
            }
        }
        JsonNode scripts = objectField(root, "scripts", errors);
        if (scripts != null) {
            for (String field : java.util.List.of("root", "validator", "wrapper")) {
                if (!scripts.has(field)) {
                    errors.add("missing scripts field: " + field);
                }
                validateRepoRelativePath(stringField(scripts, field), "scripts." + field, errors);
            }
        }
        JsonNode checks = objectField(root, "checks", errors);
        if (checks != null) {
            validateCommandList(checks.path("requiredCommands"), "checks.requiredCommands", errors);
            validateCommandList(checks.path("optionalCommands"), "checks.optionalCommands", errors);
            validateCommandList(checks.path("allowedCommandPrefixes"), "checks.allowedCommandPrefixes", errors);
        }
        JsonNode ci = objectField(root, "ci", errors);
        if (ci != null) {
            String provider = stringField(ci, "provider");
            if (!java.util.List.of("github-actions", "gitlab-ci", "none").contains(provider)) {
                errors.add("ci.provider must be one of: github-actions, gitlab-ci, none");
            }
            validateRepoRelativePath(stringField(ci, "githubWorkflow"), "ci.githubWorkflow", errors);
            validateRepoRelativePath(stringField(ci, "gitlabConfig"), "ci.gitlabConfig", errors);
            JsonNode branches = ci.path("branches");
            if (branches.isObject()) {
                for (String field : java.util.List.of("push", "pullRequest", "mergeRequest")) {
                    validateStringList(branches.path(field), "ci.branches." + field, errors);
                }
            } else if (!branches.isMissingNode()) {
                errors.add("ci.branches must be an object");
            }
        }
        JsonNode hooks = objectField(root, "hooks", errors);
        if (hooks != null) {
            for (String field : java.util.List.of("enabled", "path", "commitMsg", "prePush")) {
                if (!hooks.has(field)) {
                    errors.add("missing hooks field: " + field);
                }
            }
            if (!hooks.path("enabled").isBoolean()) {
                errors.add("hooks.enabled must be a boolean");
            }
            for (String field : java.util.List.of("path", "commitMsg", "prePush")) {
                validateRepoRelativePath(stringField(hooks, field), "hooks." + field, errors);
            }
        }
        return errors;
    }

    /** Return a required object field or append a structural validation error. */
    private JsonNode objectField(JsonNode root, String field, ArrayList<String> errors) {
        JsonNode value = root.path(field);
        if (!value.isObject()) {
            errors.add(field + " must be an object");
            return null;
        }
        return value;
    }

    /** Return a string field value from a JSON object. */
    private String stringField(JsonNode root, String field) {
        JsonNode value = root.path(field);
        if (!value.isTextual()) {
            return null;
        }
        return value.asText();
    }

    /** Validate one repository-relative path field. */
    private void validateRepoRelativePath(String value, String field, ArrayList<String> errors) {
        if (value == null) {
            return;
        }
        if (value.contains("\\") || value.matches("^[A-Za-z]:.*") || value.startsWith("/") || value.startsWith("//") || java.util.List.of(value.split("/")).contains("..")) {
            errors.add(field + " must be a repository-relative path without '..'");
        }
    }

    /** Validate one non-empty string list field. */
    private void validateStringList(JsonNode value, String field, ArrayList<String> errors) {
        if (!value.isArray() || value.isEmpty()) {
            errors.add(field + " must be a non-empty list of strings");
            return;
        }
        for (JsonNode item : value) {
            if (!item.isTextual() || item.asText().isEmpty()) {
                errors.add(field + " must be a non-empty list of strings");
                return;
            }
        }
    }

    /** Validate trusted command strings without executing them. */
    private void validateCommandList(JsonNode value, String field, ArrayList<String> errors) {
        if (value.isMissingNode() && !"checks.requiredCommands".equals(field)) {
            return;
        }
        if (!value.isArray()) {
            errors.add(field + " must be a list of commands");
            return;
        }
        java.util.List<String> trustedCommands = java.util.List.of(
            "sh scripts/harness/validate_harness.sh",
            "node scripts/harness/validate-harness.mjs",
            "./gradlew harnessCheck",
            "mvn local.harness:harness-maven-plugin:harness-check"
        );
        for (int index = 0; index < value.size(); index += 1) {
            JsonNode commandNode = value.get(index);
            if (!commandNode.isTextual()) {
                errors.add(field + " must be a list of commands");
                continue;
            }
            String command = commandNode.asText();
            if (command.matches(".*[;|&`$><\\n].*")) {
                errors.add(field + "[" + index + "] contains shell metacharacters: " + command);
            } else if (!trustedCommands.contains(command)) {
                errors.add(field + "[" + index + "] command is not an allowed argv form: " + command);
            }
        }
    }
}
