{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "codegraph",
  "version": "2026.11.07.01",
  "description": "CodeGraph CLI and MCP tools with automatic project initialization, indexing, and local Git exclusion.",
  "author": {
    "name": "ririnto"
  },
  "license": "MIT",
  "mcpServers": {
    "codegraph": {
      "command": "npx",
      "args": ["--yes", "@colbymchenry/codegraph", "serve", "--mcp"],
      "env": { "NODE_USE_SYSTEM_CA": "1" },
      "type": "stdio",
      "alwaysLoad": true
    }
  }
}
