{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "--prefer-online",
        "@colbymchenry/codegraph",
        "serve",
        "--mcp"
      ],
      "env": {
        "npm_config_cache": "${PLUGIN_DATA}/npm-cache"
      }
    }
  }
}
